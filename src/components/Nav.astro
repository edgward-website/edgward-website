---
import { getLangFromUrl, ui } from '../i18n/ui';
import { localize, getSwitchTarget } from '../i18n/routes';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = ui[lang];

const links = t.nav.links.map((l) => ({ href: localize(l.href, lang), label: l.label }));
const homeHref = lang === 'en' ? '/en' : '/';
const ctaHref = t.nav.ctaHref;
const switchTarget = getSwitchTarget(currentPath, lang === 'fr' ? 'en' : 'fr');
---

<nav class="nav" id="nav" aria-label="Navigation principale">
  <div class="nav-inner">
    <a href={homeHref} class="logo">
      <img src="/assets/sigle.png" alt="" width="36" height="36">
      <img class="logo-wordmark" src="/assets/wordmark-edgward.png" alt="Edgward" height="19">
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class={currentPath === link.href ? 'active' : ''}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="nav-lang-mobile">
        <a href={switchTarget} class="lang-switch" hreflang={lang === 'fr' ? 'en' : 'fr'} aria-label={t.nav.switchAria}>{t.nav.switchTo}</a>
      </li>
      <li class="nav-links-cta">
        <a href={ctaHref} class="mobile-cta">{t.nav.cta}</a>
      </li>
    </ul>

    <div class="nav-right">
      <a href={switchTarget} class="lang-switch nav-lang-desktop" hreflang={lang === 'fr' ? 'en' : 'fr'} aria-label={t.nav.switchAria}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>
        {t.nav.switchTo}
      </a>
      <a href={ctaHref} class="nav-cta">{t.nav.cta}</a>
    </div>

    <button
      class="burger"
      id="burger"
      aria-label={t.nav.openMenu}
      data-open-label={t.nav.openMenu}
      data-close-label={t.nav.closeMenu}
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<script>
  const burger = document.getElementById('burger');
  const navLinks = document.getElementById('nav-links');

  const openLabel = burger?.getAttribute('data-open-label') || 'Open menu';
  const closeLabel = burger?.getAttribute('data-close-label') || 'Close menu';

  burger?.addEventListener('click', () => {
    const isOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!isOpen));
    burger.setAttribute('aria-label', isOpen ? openLabel : closeLabel);
    navLinks?.classList.toggle('open');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!burger?.contains(e.target as Node) && !navLinks?.contains(e.target as Node)) {
      burger?.setAttribute('aria-expanded', 'false');
      burger?.setAttribute('aria-label', openLabel);
      navLinks?.classList.remove('open');
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .nav.scrolled { border-bottom-color: var(--border); }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    max-width: var(--container);
    margin: 0 auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--navy);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.02em;
  }
  .logo img { border-radius: 9px; }
  .logo .logo-wordmark { height: 19px; width: auto; border-radius: 0; display: block; }

  .nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
  }
  .nav-links a {
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }
  .nav-links a:hover,
  .nav-links a.active { color: var(--brand); }

  .nav-right { display: flex; align-items: center; gap: 16px; }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }
  .lang-switch:hover { color: var(--brand); }
  .lang-switch svg { opacity: 0.7; }

  .nav-cta {
    background: var(--brand);
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 1px 2px rgba(70,120,220,0.2);
  }
  .nav-cta:hover { background: var(--brand-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(70,120,220,0.3); }

  .nav-lang-mobile { display: none; }

  .burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy);
    margin: 4px 0;
    transition: all 0.25s ease;
  }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .nav-links-cta { display: none; }

  @media (max-width: 768px) {
    .nav-right { display: none; }
    .burger { display: block; }
    .nav-lang-mobile { display: list-item; }
    .nav-lang-mobile .lang-switch {
      display: block;
      padding: 12px 0;
      font-size: 16px;
      border-bottom: 1px solid var(--border);
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 16px 24px 24px;
      flex-direction: column;
      gap: 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    .nav-links.open { display: flex; }
    .nav-links li a {
      display: block;
      padding: 12px 0;
      font-size: 16px;
      border-bottom: 1px solid var(--border);
    }
    .nav-links-cta { display: list-item; }
    .nav-links-cta .mobile-cta {
      display: block;
      margin-top: 8px;
      padding: 12px 0;
      text-align: center;
      background: var(--brand);
      color: white;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      border-bottom: none;
    }
    .nav-links-cta .mobile-cta:hover { background: var(--brand-dark); }
  }
</style>
