---
/**
 * Bloc de téléchargement d'un guide/check-list au sein d'un article de blog.
 * Piloté par le frontmatter de l'article (guidePdf, guideTitle, guideDesc, guidePromo).
 * L'email est collecté via Brevo, comme sur l'accueil et dans FinalCTA.
 */
interface Props {
  pdf: string;
  title: string;
  desc?: string;
  promo?: string;
}
const { pdf, title, desc, promo } = Astro.props;
---

<section class="guide-dl" id="checklist">
  <div class="container">
    <div class="guide-card">
      <div class="guide-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="26" height="26">
          <path d="M9 12h6M9 16h6M9 8h2"/>
          <path d="M6 2h8l6 6v14H6z"/>
          <path d="M14 2v6h6"/>
        </svg>
      </div>

      <div class="guide-main">
        <span class="guide-eyebrow">À télécharger</span>
        <h2>{title}</h2>
        {desc && <p class="guide-desc">{desc}</p>}

        <div class="guide-default" id="guide-dl-default">
          <form class="guide-form" id="guide-dl-form" novalidate>
            <input type="email" name="EMAIL" placeholder="votre@email.ch" aria-label="Votre adresse email" autocomplete="email" required>
            <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="guide-hp">
            <button type="submit">Recevoir la check-list</button>
          </form>
          <p class="guide-privacy">Gratuit, au format PDF. En vous inscrivant, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>.</p>
        </div>

        <div class="guide-success" id="guide-dl-success" hidden>
          <p class="guide-thanks">Merci ! Votre check-list est prête.</p>
          <a href={pdf} download class="guide-download">
            Télécharger le PDF
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14"/></svg>
          </a>
        </div>

        {promo && <p class="guide-promo" set:html={promo} />}
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('guide-dl-form') as HTMLFormElement | null;
  const defaultBox = document.getElementById('guide-dl-default');
  const successBox = document.getElementById('guide-dl-success');
  const BREVO_ACTION = 'https://87714af1.sibforms.com/serve/MUIFAMrrWdxPBYrsJbVl3DEx2xLkeG0iVWB5XkCoCcZ22ARhk_U-AcqM-P-P1NLYOuD2EH-OCwsPhS2Wwh-tKXHv36Va4XMMimuN2LOwPbVFNIP6mpmrNr1rga5vuBAxweX_kAFYUbz6_lpfaMZREUftQYz6VOiO2LSXfcpcjqLFyrGdOBWBAfnvmeBotpNVxMQDfQSnDaVHxwYB';

  function reveal() {
    defaultBox?.setAttribute('hidden', '');
    successBox?.removeAttribute('hidden');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const honeypot = (form.elements.namedItem('email_address_check') as HTMLInputElement)?.value;
    if (honeypot) return;
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    const email = input.value.trim();
    if (!input.validity.valid || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      input.focus();
      input.reportValidity();
      return;
    }
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';

    const params = new URLSearchParams();
    params.append('EMAIL', email);
    params.append('email_address_check', '');
    params.append('locale', 'fr');

    fetch(BREVO_ACTION, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params.toString(),
    })
      .catch(() => {})
      .finally(reveal);
  });
</script>

<style>
  .guide-dl { background: white; padding: 0 0 56px; scroll-margin-top: 90px; }
  .guide-dl .container { padding-top: 0; padding-bottom: 0; }

  .guide-card {
    max-width: 680px; margin: 0 auto;
    display: flex; gap: 20px;
    background: var(--soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 28px 28px 26px;
  }

  .guide-visual {
    flex: none; width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius);
    background: var(--brand-soft); color: var(--brand);
  }

  .guide-main { flex: 1; min-width: 0; }

  .guide-eyebrow {
    display: block;
    font-size: 11px; font-weight: 700; color: var(--brand);
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 6px;
  }
  .guide-main h2 {
    font-size: 20px; font-weight: 700; color: var(--navy);
    line-height: 1.25; letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .guide-desc {
    font-size: 14px; line-height: 1.6; color: var(--text-muted);
    margin: 0 0 18px;
  }

  .guide-form { display: flex; gap: 8px; }
  .guide-form input[type="email"] {
    flex: 1; min-width: 0;
    padding: 11px 14px;
    font-family: inherit; font-size: 14px; color: var(--navy);
    background: white;
    border: 1px solid var(--border); border-radius: 8px;
  }
  .guide-form input[type="email"]:focus {
    outline: none; border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }
  .guide-form button {
    flex: none;
    padding: 11px 20px;
    font-family: inherit; font-size: 14px; font-weight: 600;
    color: white; background: var(--brand);
    border: none; border-radius: 8px; cursor: pointer;
    transition: background 0.15s ease;
  }
  .guide-form button:hover:not(:disabled) { background: var(--brand-dark); }
  .guide-form button:disabled { opacity: 0.6; cursor: default; }
  .guide-hp { position: absolute; left: -9999px; width: 1px; height: 1px; }

  .guide-privacy {
    font-size: 12px; color: var(--text-light); line-height: 1.5;
    margin: 10px 0 0;
  }
  .guide-privacy a { color: var(--text-muted); text-decoration: underline; }

  .guide-thanks {
    font-size: 14px; font-weight: 600; color: var(--navy);
    margin: 0 0 12px;
  }
  .guide-download {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 20px;
    font-size: 14px; font-weight: 600;
    color: white; background: var(--brand);
    border-radius: 8px; text-decoration: none;
    transition: background 0.15s ease;
  }
  .guide-download:hover { background: var(--brand-dark); }

  .guide-promo {
    margin: 18px 0 0; padding-top: 16px;
    border-top: 1px dashed var(--border);
    font-size: 13px; line-height: 1.6; color: var(--text-muted);
  }
  .guide-promo :global(code) {
    display: inline-block;
    font-family: inherit; font-size: 12px; font-weight: 800;
    letter-spacing: 0.06em; color: white; background: var(--navy);
    padding: 3px 9px; border-radius: 5px;
  }
  .guide-promo :global(strong) { color: var(--navy); font-weight: 700; }

  @media (max-width: 640px) {
    .guide-card { flex-direction: column; gap: 16px; padding: 24px 20px; }
    .guide-form { flex-direction: column; }
    .guide-form button { width: 100%; }
  }
</style>
