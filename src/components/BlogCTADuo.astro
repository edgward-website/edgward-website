---
// Duo de conversion B2C en fin d'article : deux encadrés côte à côte sur ordinateur
// (carte "Passez à l'action" + carte "tunnel /particuliers"), empilés sur mobile
// avec la carte "Passez à l'action" en premier. Activé par le frontmatter `ctaDuo: true`.
import { site } from '../data/site';
---

<section class="blog-cta-duo">
  <div class="container">
    <div class="bcd-grid">

      <!-- Carte 1 : Passez à l'action (téléchargement app) -->
      <div class="bcd-card bcd-action">
        <h2>Un doute, une absence, une alerte ?<br><em>Passez à l'action.</em></h2>
        <p class="bcd-lead">Avec Edgward, un agent partenaire intervient à votre adresse quand vous en avez besoin. Sans installation, sans engagement, jusqu'à <strong>5x moins cher</strong> qu'une télésurveillance classique. <strong>Le premier mois est offert.</strong></p>

        <div class="bcd-stores">
          <a href={site.apps.appStore} class="store-btn" target="_blank" rel="noopener noreferrer" aria-label="Télécharger sur l'App Store">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            <span class="store-txt"><span class="store-sub">Télécharger sur</span><span class="store-main">App Store</span></span>
          </a>
          <a href={site.apps.playStore} class="store-btn" target="_blank" rel="noopener noreferrer" aria-label="Disponible sur Google Play">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.19l2.807 1.626a1 1 0 010 1.73l-2.808 1.626-2.496-2.491 2.497-2.491zM5.864 2.658L16.802 8.99l-2.302 2.302-8.636-8.634z"/></svg>
            <span class="store-txt"><span class="store-sub">Disponible sur</span><span class="store-main">Google Play</span></span>
          </a>
        </div>

        <p class="bcd-objection">
          Vous avez déjà une alarme ? Edgward s'occupe de la <strong>levée de doute</strong>, sans faire doublon.
          <a href="/intervention-alarme">Voir l'intervention sur alarme →</a>
        </p>

        <p class="bcd-multi">Résidence principale, secondaire, domicile d'un proche : gérez plusieurs adresses depuis un seul compte.</p>
      </div>

      <!-- Carte 2 : le tunnel /particuliers -->
      <div class="bcd-card bcd-funnel">
        <p class="bcd-eyebrow">Sécurité à la demande</p>
        <h3>Gardez un œil sur votre domicile, où que vous soyez</h3>
        <p class="bcd-funnel-lead">Alertes de proximité, intervention d'un agent partenaire en quelques minutes, compte rendu à chaque passage. Sans installation, sans engagement.</p>
        <a href="/particuliers" class="bcd-funnel-btn">Découvrir la sécurité à la demande →</a>
      </div>

    </div>
  </div>
</section>

<style>
  .blog-cta-duo { padding: 56px 0; }
  .bcd-grid { display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; }

  /* Encadrés côte à côte sur ordinateur, empilés sur mobile.
     La carte principale (action) est volontairement plus large et plus grande
     que la carte secondaire (tunnel), pour attirer l'œil en premier. */
  .bcd-card {
    background: #0a1929;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }
  .bcd-action { flex: 1.6 1 380px; padding: 32px; }
  .bcd-funnel { flex: 1 1 260px; padding: 24px; }

  /* --- Carte "Passez à l'action" --- */
  .bcd-action::before {
    content: ''; position: absolute; top: -140px; right: -100px; width: 360px; height: 360px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%); pointer-events: none;
  }
  .bcd-action > * { position: relative; z-index: 1; }
  .bcd-action h2 {
    font-size: clamp(22px, 2.4vw, 28px); font-weight: 800; line-height: 1.15;
    letter-spacing: -0.02em; color: #fff; margin: 0 0 14px;
  }
  .bcd-action h2 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .bcd-lead { font-size: 15px; line-height: 1.6; color: #cbd5e1; margin: 0 0 20px; }
  .bcd-lead strong { color: #fff; font-weight: 700; }

  .bcd-stores { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  .store-btn { background: #000; border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 10px 18px; border-radius: 10px; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: all 0.2s ease; }
  .store-btn:hover { background: #1a1a1a; border-color: rgba(255,255,255,0.3); transform: translateY(-2px); }
  .store-txt { display: flex; flex-direction: column; line-height: 1.15; }
  .store-sub { font-size: 10px; color: #94a3b8; }
  .store-main { font-size: 14px; font-weight: 600; }

  .bcd-objection {
    font-size: 14px; line-height: 1.6; color: #cbd5e1;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius); padding: 14px 18px; margin: 0 0 16px;
  }
  .bcd-objection strong { color: #fff; font-weight: 700; }
  .bcd-objection a { color: var(--brand-light); text-decoration: none; font-weight: 600; }
  .bcd-objection a:hover { color: #fff; text-decoration: underline; }
  .bcd-multi { font-size: 13px; color: #94a3b8; margin: 0; font-style: italic; }

  /* --- Carte "tunnel /particuliers" --- */
  .bcd-funnel { display: flex; flex-direction: column; justify-content: center; }
  .bcd-eyebrow { margin: 0 0 6px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #6B93E8; }
  .bcd-funnel h3 { margin: 0 0 10px; font-size: clamp(17px, 1.7vw, 20px); line-height: 1.25; color: #fff; }
  .bcd-funnel-lead { margin: 0 0 18px; color: #94a3b8; line-height: 1.55; font-size: 13.5px; }
  .bcd-funnel-btn { display: inline-block; align-self: flex-start; background: #4678DC; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; padding: 10px 20px; border-radius: 10px; transition: all 0.2s ease; }
  .bcd-funnel-btn:hover { background: #3a68c8; transform: translateY(-2px); }

  /* Sur mobile : "Passez à l'action" (première carte du DOM) apparaît en premier — comportement naturel de l'empilement. */
</style>
