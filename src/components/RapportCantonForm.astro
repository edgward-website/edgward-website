---
/**
 * Capture e-mail pour le rapport mensuel de sécurité, personnalisé par canton.
 * Même mécanique Brevo que BlogGuideDownload (honeypot + piège temporel, POST no-cors).
 * Le rapport étant mensuel, la confirmation annonce un envoi par e-mail (pas de
 * téléchargement immédiat). Le contact est rangé par canton côté Brevo (attribut CANTON).
 *
 * À FAIRE (Daniel) : remplacer BREVO_ACTION ci-dessous par l'URL du formulaire Brevo
 * dédié « Rapport mensuel » (Brevo > Contacts > Formulaires), et y déclarer un attribut
 * CANTON. Tant que l'URL n'est pas remplacée, l'inscription affiche la confirmation
 * mais n'enregistre rien.
 */
const CANTONS = [
  { code: 'GE', nom: 'Genève' }, { code: 'VD', nom: 'Vaud' }, { code: 'VS', nom: 'Valais' },
  { code: 'NE', nom: 'Neuchâtel' }, { code: 'FR', nom: 'Fribourg' }, { code: 'JU', nom: 'Jura' },
];
---

<section class="rc" id="rapport">
  <div class="container">
    <div class="rc-card">
      <div class="rc-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="26" height="26">
          <path d="M6 2h8l6 6v14H6z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" />
        </svg>
      </div>
      <div class="rc-main">
        <span class="rc-eyebrow">Rapport mensuel gratuit</span>
        <h2>Recevez chaque mois la synthèse de sécurité de votre canton</h2>
        <p class="rc-desc">Tendances du mois, communes concernées et sources, dans un rapport clair et neutre - directement par e-mail.</p>

        <div id="rc-default">
          <form class="rc-form" id="rc-form" novalidate>
            <div class="rc-row">
              <label class="rc-field">
                <span>Votre canton</span>
                <select name="CANTON" id="rc-canton" aria-label="Votre canton" required>
                  <option value="" disabled selected>Choisir…</option>
                  {CANTONS.map((c) => <option value={c.code}>{c.nom}</option>)}
                </select>
              </label>
              <label class="rc-field">
                <span>Votre e-mail</span>
                <input type="email" name="EMAIL" placeholder="votre@email.ch" autocomplete="email" required />
              </label>
            </div>
            <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="rc-hp" />
            <button type="submit" class="btn btn-primary rc-submit">Recevoir le rapport</button>
          </form>
          <p class="rc-privacy">Gratuit, un envoi par mois. En vous inscrivant, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>. Désinscription en un clic.</p>
        </div>

        <div id="rc-success" hidden>
          <p class="rc-thanks" id="rc-thanks">Merci ! Votre prochain rapport arrivera par e-mail.</p>
          <p class="rc-next">En attendant, <a href="/#telecharger">téléchargez l'application Edgward</a> pour être alerté dès qu'un événement survient près de chez vous.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('rc-form');
  const box = document.getElementById('rc-default');
  const success = document.getElementById('rc-success');
  const thanks = document.getElementById('rc-thanks');

  // À REMPLACER par l'URL du formulaire Brevo « Rapport mensuel » (avec attribut CANTON).
  const BREVO_ACTION = '';

  const CANTONS = { GE: 'Genève', VD: 'Vaud', VS: 'Valais', NE: 'Neuchâtel', FR: 'Fribourg', JU: 'Jura' };
  const DELAI_MIN_MS = 1500;
  const chargeA = Date.now();

  function reveal(canton) {
    if (canton && CANTONS[canton]) thanks.textContent = 'Merci ! Votre prochain rapport ' + CANTONS[canton] + ' arrivera par e-mail.';
    box.setAttribute('hidden', '');
    success.removeAttribute('hidden');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (form.email_address_check.value) return;
    if (Date.now() - chargeA < DELAI_MIN_MS) return;
    const email = form.EMAIL.value.trim();
    const canton = form.CANTON.value;
    if (!canton) { form.CANTON.focus(); return; }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { form.EMAIL.focus(); form.EMAIL.reportValidity(); return; }

    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true; btn.textContent = 'Envoi…';

    const done = () => {
      reveal(canton);
      window.gtag?.('event', 'rapport_canton_inscription', { canton });
    };

    if (!BREVO_ACTION) { done(); return; } // pas encore branché : on confirme sans enregistrer
    const params = new URLSearchParams();
    params.append('EMAIL', email);
    params.append('CANTON', canton);
    params.append('email_address_check', '');
    params.append('locale', 'fr');
    fetch(BREVO_ACTION, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
      .catch(() => {})
      .finally(done);
  });
</script>

<style>
  .rc { padding: 8px 0 0; }
  .rc-card {
    max-width: 760px; margin: 0 auto; display: flex; gap: 20px;
    background: var(--brand-soft); border: 1px solid rgba(70, 120, 220, 0.22);
    border-left: 3px solid var(--brand); border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 28px;
  }
  .rc-visual { flex: none; width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius); background: #fff; color: var(--brand); border: 1px solid rgba(70,120,220,.2); }
  .rc-main { flex: 1; min-width: 0; }
  .rc-eyebrow { display: block; font-size: 11px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
  .rc-main h2 { font-size: 21px; font-weight: 800; color: var(--navy); line-height: 1.25; letter-spacing: -.02em; margin: 0 0 8px; }
  .rc-desc { font-size: 14px; line-height: 1.6; color: var(--text-muted); margin: 0 0 18px; }
  .rc-form { display: flex; flex-direction: column; gap: 12px; }
  .rc-row { display: flex; gap: 10px; }
  .rc-field { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .rc-field span { font-size: 12px; font-weight: 600; color: var(--text-muted); }
  .rc-field select, .rc-field input { width: 100%; padding: 11px 14px; font-family: inherit; font-size: 14px; color: var(--navy); background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .rc-field select:focus, .rc-field input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .rc-submit { align-self: flex-start; }
  .rc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .rc-privacy { font-size: 12px; color: var(--text-light); line-height: 1.5; margin: 10px 0 0; }
  .rc-privacy a { color: var(--text-muted); text-decoration: underline; }
  .rc-thanks { font-size: 15px; font-weight: 700; color: var(--navy); margin: 0 0 8px; }
  .rc-next { font-size: 13px; color: var(--text-muted); margin: 0; }
  .rc-next a { color: var(--brand); font-weight: 600; text-decoration: underline; }
  @media (max-width: 600px) {
    .rc-card { flex-direction: column; gap: 16px; padding: 24px 20px; }
    .rc-row { flex-direction: column; }
    .rc-submit { width: 100%; justify-content: center; }
  }
</style>
