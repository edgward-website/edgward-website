---
/**
 * « Voir le rapport de sa commune, le télécharger, puis s'abonner. »
 * Étape 1 : le visiteur choisit canton + commune et voit immédiatement un rapport
 * personnalisé du dernier mois complet (carte du canton situant la commune, chiffres,
 * événements), sans e-mail.
 * Étape 2 : il peut le télécharger en PDF, et/ou s'abonner pour le recevoir chaque mois.
 *
 * À FAIRE (Daniel) : remplacer BREVO_ACTION par l'URL du formulaire Brevo
 * « Rapport mensuel » (attributs CANTON et COMMUNE, double opt-in). Tant qu'elle
 * est vide, l'inscription confirme à l'écran mais n'enregistre rien.
 */
import communesData from '../data/communes-par-canton.json';
import geoData from '../data/cantons-romands.json';
import archive from '../data/evenements-archive.json';
import doublons from '../data/doublons-exclus.json';

const COMMUNES = communesData.communes as Record<string, { n: string; lon: number | null; lat: number | null }[]>;
const CANTONS = [
  { code: 'GE', nom: 'Genève' }, { code: 'VD', nom: 'Vaud' }, { code: 'VS', nom: 'Valais' },
  { code: 'NE', nom: 'Neuchâtel' }, { code: 'FR', nom: 'Fribourg' }, { code: 'JU', nom: 'Jura' },
];
const ROMANDS = new Set(CANTONS.map((c) => c.code));
const MOIS_FR: Record<string, string> = { '01': 'janvier', '02': 'février', '03': 'mars', '04': 'avril', '05': 'mai', '06': 'juin', '07': 'juillet', '08': 'août', '09': 'septembre', '10': 'octobre', '11': 'novembre', '12': 'décembre' };
const DEBUT = '2026-08';
const A = 192.0, Bx = -1081.9, C = -276.6, Dy = 13248.9;

const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
  .replace(/\bsaint(e)?\b/g, (m) => (m.endsWith('e') ? 'ste' : 'st')).replace(/[^a-z0-9]/g, '');

const exclus = new Set((doublons as any).exclus as string[]);
const cle = (e: any) => [e.commune, (e.dateVue || '').slice(0, 10), e.titre].join(' | ');
const parts = new Intl.DateTimeFormat('fr-CH', { timeZone: 'Europe/Zurich', year: 'numeric', month: '2-digit' }).formatToParts(new Date());
const moisCourant = `${parts.find((p) => p.type === 'year')!.value}-${parts.find((p) => p.type === 'month')!.value}`;

const perCommune: Record<string, { k: string; parMois: Record<string, { d: string; cat: string; t: string; s: string }[]> }> = {};
const cantonParMois: Record<string, Record<string, number>> = {};
const hotAgg: Record<string, Record<string, Record<string, { x: number; y: number; n: number }>>> = {};
const moisSet = new Set<string>();
for (const e of archive.evenements as any[]) {
  const m = (e.dateVue || '').slice(0, 7);
  if (!ROMANDS.has(e.canton) || m < DEBUT || m === moisCourant || exclus.has(cle(e)) || typeof e.lon !== 'number') continue;
  moisSet.add(m);
  (cantonParMois[e.canton] ||= {})[m] = ((cantonParMois[e.canton] ||= {})[m] || 0) + 1;
  const k = norm(e.commune);
  const rec = (perCommune[k] ||= { k: e.canton, parMois: {} });
  (rec.parMois[m] ||= []).push({ d: (e.dateVue || '').slice(8, 10) + '.' + (e.dateVue || '').slice(5, 7), cat: e.categorie, t: e.titre, s: e.source || '' });
  const hm = ((hotAgg[e.canton] ||= {})[m] ||= {});
  const h = (hm[k] ||= { x: 0, y: 0, n: 0 });
  h.x += A * e.lon + Bx; h.y += C * e.lat + Dy; h.n++;
}
const mois = [...moisSet].sort();
const dernierMois = mois[mois.length - 1] || DEBUT;
const dernierLabel = `${MOIS_FR[dernierMois.slice(5)]} ${dernierMois.slice(0, 4)}`;
const hotspots: Record<string, { x: number; y: number; n: number }[]> = {};
for (const k of Object.keys(hotAgg)) {
  const mm = hotAgg[k][dernierMois] || {};
  hotspots[k] = Object.values(mm).map((o) => ({ x: +(o.x / o.n).toFixed(1), y: +(o.y / o.n).toFixed(1), n: o.n }));
}

// Encart de contexte : Suisse romande (fixe) + profil du canton + situation de la commune (calculée)
const ROMANDIE = "La Suisse romande demeure une région sûre : la majorité des événements recensés relèvent d'accidents et d'incendies plutôt que d'atteintes directes aux personnes.";
const CANTON_PROFIL: Record<string, string> = {
  GE: "Genève, canton très urbain, connaît une activité surtout routière et citadine - pertes de maîtrise, collisions, mobilité douce - les atteintes aux biens y restant ponctuelles.",
  VD: "Vaud, canton le plus peuplé de Romandie, concentre logiquement le plus d'événements, en particulier sur ses axes routiers et son réseau ferroviaire.",
  VS: "En Valais, la montagne pèse fortement dans le bilan : une part notable des accidents survient en altitude (chutes, alpinisme, randonnée), aux côtés des accidents de la route.",
  NE: "Neuchâtel connaît une activité contenue ; l'Arc jurassien voit ponctuellement des atteintes à son patrimoine horloger.",
  FR: "Fribourg voit son activité marquée par ses axes autoroutiers et quelques incendies ; la délinquance organisée y reste l'exception.",
  JU: "Le Jura, peu densément peuplé, enregistre peu d'événements, essentiellement des accidents de la route et des incendies.",
};
const cantonStats: Record<string, { total: number; concernees: number; maxC: number; nbTotal: number }> = {};
for (const c of CANTONS) {
  const k = c.code;
  const hs = hotspots[k] || [];
  cantonStats[k] = { total: (cantonParMois[k] || {})[dernierMois] || 0, concernees: hs.length, maxC: hs.reduce((m, h) => Math.max(m, h.n), 0), nbTotal: (COMMUNES[k] || []).length };
}

const geo = {
  cantons: (geoData.cantons as any[]).filter((c) => ROMANDS.has(c.code)).map((c) => ({ code: c.code, d: c.d })),
  lakes: geoData.lakes as string[],
};
const reportData = { perCommune, cantonParMois, hotspots, dernierMois, dernierLabel, communes: COMMUNES, geo, romandie: ROMANDIE, profils: CANTON_PROFIL, cantonStats };
---

<section class="rc" id="rapport">
  <div class="container">
    <div class="rc-card">
      <div class="rc-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="26" height="26">
          <path d="M6 2h8l6 6v14H6z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" />
        </svg>
      </div>
      <div class="rc-main">
        <span class="rc-eyebrow">Rapport de sécurité · gratuit</span>
        <h2>Le rapport de sécurité de votre commune</h2>
        <p class="rc-desc">Choisissez votre commune pour voir son rapport du mois - téléchargeable, et à recevoir chaque mois par e-mail.</p>

        <div id="rc-step1">
          <div class="rc-row">
            <label class="rc-field">
              <span>Votre canton</span>
              <select id="rc-canton" aria-label="Votre canton">
                <option value="" disabled selected>Choisir…</option>
                {CANTONS.map((c) => <option value={c.code}>{c.nom}</option>)}
              </select>
            </label>
            <label class="rc-field">
              <span>Votre commune</span>
              <select id="rc-commune" aria-label="Votre commune" disabled>
                <option value="" disabled selected>Choisissez d'abord le canton</option>
              </select>
              <input type="text" id="rc-commune-autre" placeholder="Nom de votre commune" autocomplete="address-level2" aria-label="Nom de votre commune" hidden />
            </label>
          </div>
          <button type="button" id="rc-voir" class="btn btn-primary rc-submit">Voir le rapport de ma commune</button>
        </div>

        <div id="rc-report" hidden>
          <button type="button" id="rc-retour" class="rc-retour">&#8592; Changer de commune</button>
          <div id="rc-report-body" class="rc-doc"></div>
          <div class="rc-actions">
            <button type="button" id="rc-dl" class="btn btn-primary">Télécharger le rapport (PDF)</button>
          </div>

          <div class="rc-sub" id="rc-sub">
            <p class="rc-sub-title">Recevez le rapport de <b id="rc-sub-commune"></b> chaque mois</p>
            <form class="rc-subform" id="rc-subform" novalidate>
              <input type="email" name="EMAIL" placeholder="votre@email.ch" autocomplete="email" aria-label="Votre e-mail" required />
              <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="rc-hp" />
              <button type="submit" class="btn btn-primary">Recevoir chaque mois</button>
            </form>
            <p class="rc-privacy">Gratuit, un envoi par mois. En vous inscrivant, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>. Désinscription en un clic.</p>
          </div>
        </div>

        <div id="rc-success" hidden>
          <p class="rc-thanks" id="rc-thanks">Merci ! Votre prochain rapport arrivera par e-mail.</p>
          <p class="rc-next">En attendant, <a href="/#telecharger">téléchargez l'application Edgward</a> pour être alerté dès qu'un événement survient près de chez vous.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="rc-data" set:html={JSON.stringify(reportData)}></script>

<script>
  const D = JSON.parse(document.getElementById('rc-data').textContent);
  const CATS = {
    cambriolage: { l: 'Cambriolages', c: '#f59e0b' }, agression: { l: 'Agressions', c: '#ef4444' },
    incendie: { l: 'Incendies', c: '#fb7a3c' }, accident: { l: 'Accidents', c: '#2563eb' },
    disparition: { l: 'Disparitions', c: '#8b5cf6' }, ordre: { l: 'Ordre public', c: '#0891b2' }, cyber: { l: 'Cyber', c: '#059669' },
  };
  const CANTONS = { GE: 'Genève', VD: 'Vaud', VS: 'Valais', NE: 'Neuchâtel', FR: 'Fribourg', JU: 'Jura' };
  const A = 192.0, Bx = -1081.9, C = -276.6, Dy = 13248.9;
  const BREVO_ACTION = ''; // À REMPLACER par l'URL du formulaire Brevo (attributs CANTON + COMMUNE, double opt-in).
  const DELAI_MIN_MS = 1500;
  const chargeA = Date.now();
  const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\bsaint(e)?\b/g, (m) => (m.endsWith('e') ? 'ste' : 'st')).replace(/[^a-z0-9]/g, '');

  const step1 = document.getElementById('rc-step1');
  const report = document.getElementById('rc-report');
  const reportBody = document.getElementById('rc-report-body');
  const success = document.getElementById('rc-success');
  const thanks = document.getElementById('rc-thanks');
  const cantonSel = document.getElementById('rc-canton');
  const communeSel = document.getElementById('rc-commune');
  const communeAutre = document.getElementById('rc-commune-autre');
  const subCommune = document.getElementById('rc-sub-commune');
  let choix = { canton: '', commune: '' };

  cantonSel.addEventListener('change', () => {
    const list = D.communes[cantonSel.value] || [];
    communeSel.innerHTML = '<option value="" disabled selected>Choisir…</option>'
      + list.map((c) => '<option>' + c.n + '</option>').join('')
      + '<option value="_autre">Ma commune n\'est pas dans la liste…</option>';
    communeSel.disabled = false;
    communeAutre.hidden = true; communeAutre.value = '';
  });
  communeSel.addEventListener('change', () => {
    const autre = communeSel.value === '_autre';
    communeAutre.hidden = !autre;
    if (autre) communeAutre.focus();
  });
  function resoudreCommune() { let c = communeSel.value; if (c === '_autre') c = communeAutre.value.trim(); return c; }

  function bbox(d) { const re = /(-?[\d.]+),(-?[\d.]+)/g; let m, xs = [], ys = []; while ((m = re.exec(d))) { xs.push(+m[1]); ys.push(+m[2]); } return { x: Math.min(...xs), y: Math.min(...ys), X: Math.max(...xs), Y: Math.max(...ys) }; }

  function carteSVG(canton, commune) {
    const g = D.geo.cantons.find((c) => c.code === canton); if (!g) return '';
    const bb = bbox(g.d), pad = 6;
    const vb = { x: bb.x - pad, y: bb.y - pad, w: (bb.X - bb.x) + 2 * pad, h: (bb.Y - bb.y) + 2 * pad };
    const fs = vb.w * 0.03;
    let s = '<svg class="rc-map" viewBox="' + [vb.x, vb.y, vb.w, vb.h].join(' ') + '" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Carte de ' + esc(commune) + '">';
    s += '<path d="' + g.d + '" fill="#e9edf3" stroke="#cdd7e5" stroke-width="0.5"/>';
    D.geo.lakes.forEach((d) => { s += '<path d="' + d + '" fill="#cfe8f5" stroke="#bcdcef" stroke-width="0.3"/>'; });
    (D.hotspots[canton] || []).forEach((p) => { s += '<circle cx="' + p.x + '" cy="' + p.y + '" r="' + (0.8 + Math.min(1.8, Math.sqrt(p.n) * 0.5)).toFixed(2) + '" fill="#9fb0c4" opacity="0.55"/>'; });
    const co = (D.communes[canton] || []).find((c) => norm(c.n) === norm(commune));
    if (co && co.lon != null) {
      const x = A * co.lon + Bx, y = C * co.lat + Dy;
      s += '<circle cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" r="' + (fs * 1.6).toFixed(2) + '" fill="#4678DC" opacity="0.18"/>';
      s += '<circle cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" r="' + (fs * 0.55).toFixed(2) + '" fill="#4678DC" stroke="#fff" stroke-width="' + (fs * 0.12).toFixed(2) + '"/>';
      s += '<text x="' + x.toFixed(1) + '" y="' + (y - fs * 0.9).toFixed(1) + '" text-anchor="middle" font-family="Manrope,sans-serif" font-weight="800" font-size="' + fs.toFixed(2) + '" fill="#0a1929" paint-order="stroke" stroke="#fff" stroke-width="' + (fs * 0.3).toFixed(2) + '">' + esc(commune) + '</text>';
    }
    s += '</svg>'; return s;
  }

  function rapportHTML(canton, commune) {
    const rec = D.perCommune[norm(commune)];
    const evs = (rec && rec.k === canton && rec.parMois[D.dernierMois]) ? rec.parMois[D.dernierMois] : [];
    const cantonTot = (D.cantonParMois[canton] && D.cantonParMois[canton][D.dernierMois]) || 0;
    const cats = {}; evs.forEach((e) => (cats[e.cat] = (cats[e.cat] || 0) + 1));
    const dom = Object.entries(cats).sort((a, b) => b[1] - a[1])[0];
    let h = '<div class="rc-rhead"><div class="rc-rwm"><span class="rc-rm">E</span>EDGWARD</div>'
      + '<div class="rc-rhi"><span class="rc-rtag">Rapport de sécurité</span><div class="rc-rtitle">' + esc(commune) + '</div><div class="rc-rmo">' + esc(CANTONS[canton] || canton) + ' · ' + D.dernierLabel + '</div></div></div>';
    h += '<div class="rc-rgrid"><div class="rc-rmapwrap">' + carteSVG(canton, commune) + '<div class="rc-rmapcap">' + esc(commune) + ' dans le canton · chaque point gris = une commune concernée ce mois</div></div><div class="rc-rside">';
    h += '<div class="rc-rkpis"><div class="rc-rkpi"><b>' + evs.length + '</b><span>événement' + (evs.length > 1 ? 's' : '') + '</span></div>' + (dom ? '<div class="rc-rkpi"><b>' + dom[1] + '</b><span>' + (CATS[dom[0]] ? CATS[dom[0]].l.toLowerCase() : dom[0]) + '</span></div>' : '') + '</div>';
    if (evs.length) {
      h += '<div class="rc-evs">' + evs.map((e) => { const c = CATS[e.cat] || { l: e.cat, c: '#64748b' };
        return '<div class="rc-ev"><span class="rc-ev-d">' + e.d + '</span><span class="rc-ev-b"><span class="rc-ev-t">' + esc(e.t) + '</span>' + (e.s ? '<span class="rc-ev-s">' + esc(e.s) + '</span>' : '') + '</span><span class="rc-ev-c" style="color:' + c.c + '">' + c.l + '</span></div>';
      }).join('') + '</div>';
    } else {
      h += '<p class="rc-rcalm">Aucun événement de sécurité relayé à ' + esc(commune) + ' en ' + D.dernierLabel + '. Un mois calme, selon les sources publiques.</p>';
    }
    h += '</div></div>';
    const st = D.cantonStats[canton] || { total: 0, concernees: 0, maxC: 0, nbTotal: 0 };
    let ligne;
    if (!evs.length) ligne = 'Aucun événement n\'a été relayé à ' + esc(commune) + ' en ' + D.dernierLabel + ', comme pour la plupart des communes du canton (' + Math.max(0, st.nbTotal - st.concernees) + ' sur ' + st.nbTotal + ' sans fait recensé ce mois).';
    else if (st.maxC && evs.length >= st.maxC) ligne = 'Avec ' + evs.length + ' événement' + (evs.length > 1 ? 's' : '') + ', ' + esc(commune) + ' figure parmi les communes les plus concernées du canton ce mois.';
    else ligne = esc(commune) + ' enregistre ' + evs.length + ' événement' + (evs.length > 1 ? 's' : '') + ' en ' + D.dernierLabel + ', un niveau modéré à l\'échelle du canton.';
    h += '<div class="rc-rencart"><h4>Le contexte</h4><p>' + D.romandie + ' ' + (D.profils[canton] || '') + ' ' + ligne + '</p></div>';
    h += '<p class="rc-rctx">Dans le canton de ' + esc(CANTONS[canton] || canton) + ' : <b>' + cantonTot + '</b> événement' + (cantonTot > 1 ? 's' : '') + ' recensé' + (cantonTot > 1 ? 's' : '') + ' en ' + D.dernierLabel + '. Sources : médias romands et communiqués de police, recensés et dédoublonnés automatiquement par Edgward. Données neutres, sans information personnelle.</p>';
    return h;
  }

  function afficher() {
    const canton = cantonSel.value, commune = resoudreCommune();
    if (!canton) { cantonSel.focus(); return; }
    if (!commune) { (communeSel.value === '_autre' ? communeAutre : communeSel).focus(); return; }
    choix = { canton, commune };
    reportBody.innerHTML = rapportHTML(canton, commune);
    subCommune.textContent = commune;
    step1.hidden = true; report.hidden = false;
    report.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.getElementById('rc-voir').addEventListener('click', afficher);
  document.getElementById('rc-retour').addEventListener('click', () => { report.hidden = true; step1.hidden = false; });

  // Téléchargement : page imprimable autonome -> « Enregistrer en PDF »
  document.getElementById('rc-dl').addEventListener('click', () => {
    const corps = rapportHTML(choix.canton, choix.commune);
    const style = document.getElementById('rc-print-style').textContent;
    const w = window.open('', '_blank');
    if (!w) return;
    w.document.write('<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>Rapport sécurité ' + esc(choix.commune) + ' - ' + esc(D.dernierLabel) + '</title>'
      + '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>'
      + '<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">'
      + '<style>' + style + '</style></head><body><div class="rc-doc rc-print">' + corps
      + '<div class="rc-pfoot"><b>Edgward</b> - service d\'intervention de sécurité à la demande en Suisse romande. edgward.ch</div></div>'
      + '<scr' + 'ipt>window.onload=function(){setTimeout(function(){window.print();},400);};</scr' + 'ipt></body></html>');
    w.document.close();
  });

  function reveal() {
    thanks.textContent = 'Merci ! Le rapport de ' + choix.commune + ' vous sera envoyé chaque mois par e-mail.';
    report.hidden = true; success.removeAttribute('hidden');
  }
  document.getElementById('rc-subform').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target;
    if (f.email_address_check.value) return;
    if (Date.now() - chargeA < DELAI_MIN_MS) return;
    const email = f.EMAIL.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { f.EMAIL.focus(); f.EMAIL.reportValidity(); return; }
    const btn = f.querySelector('button[type="submit"]');
    btn.disabled = true; btn.textContent = 'Envoi…';
    const done = () => { reveal(); window.gtag?.('event', 'rapport_commune_inscription', { canton: choix.canton, commune: choix.commune }); };
    if (!BREVO_ACTION) { done(); return; }
    const params = new URLSearchParams();
    params.append('EMAIL', email); params.append('CANTON', choix.canton); params.append('COMMUNE', choix.commune);
    params.append('email_address_check', ''); params.append('locale', 'fr');
    fetch(BREVO_ACTION, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
      .catch(() => {}).finally(done);
  });
</script>

<!-- Styles du rapport, partagés entre l'affichage et la version imprimable -->
<style is:global id="rc-print-style-src">
  .rc-doc { background: #fff; border: 1px solid var(--border, #e5e7eb); border-radius: 12px; padding: 22px; color: #0a1929; font-family: 'Manrope', system-ui, sans-serif; }
  .rc-rhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; border-bottom: 2px solid #0a1929; padding-bottom: 12px; }
  .rc-rwm { font-weight: 800; font-size: 15px; display: flex; align-items: center; gap: 7px; white-space: nowrap; }
  .rc-rwm .rc-rm { width: 23px; height: 23px; border-radius: 6px; background: #4678DC; color: #fff; display: grid; place-items: center; font-size: 12px; }
  .rc-rhi { text-align: right; }
  .rc-rtag { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: #4678DC; font-weight: 800; }
  .rc-rtitle { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; line-height: 1.05; }
  .rc-rmo { font-size: 12.5px; color: #64748b; text-transform: capitalize; }
  .rc-rgrid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 20px; align-items: start; margin-top: 16px; }
  .rc-rmapwrap { border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; background: #f4f7fb; }
  .rc-map { display: block; width: 100%; height: auto; }
  .rc-rmapcap { font-size: 10px; color: #6b7280; padding: 6px 8px; text-align: center; }
  .rc-rkpis { display: flex; gap: 10px; margin-bottom: 12px; }
  .rc-rkpi { background: rgba(70,120,220,.1); border-radius: 10px; padding: 9px 14px; }
  .rc-rkpi b { display: block; font-family: 'Instrument Serif', serif; font-size: 26px; line-height: 1; }
