---
/**
 * « Voir le rapport de sa commune, puis s'abonner. »
 * Étape 1 : le visiteur choisit canton + commune et voit immédiatement le rapport
 * du dernier mois complet pour sa commune (données déjà compilées, sans e-mail).
 * Étape 2 : il peut demander à le recevoir chaque mois (capture Brevo).
 *
 * À FAIRE (Daniel) : remplacer BREVO_ACTION par l'URL du formulaire Brevo
 * « Rapport mensuel » (attributs CANTON et COMMUNE, double opt-in). Tant qu'elle
 * est vide, l'inscription confirme à l'écran mais n'enregistre rien.
 */
import communesData from '../data/communes-par-canton.json';
import archive from '../data/evenements-archive.json';
import doublons from '../data/doublons-exclus.json';

const COMMUNES = communesData.communes as Record<string, string[]>;
const CANTONS = [
  { code: 'GE', nom: 'Genève' }, { code: 'VD', nom: 'Vaud' }, { code: 'VS', nom: 'Valais' },
  { code: 'NE', nom: 'Neuchâtel' }, { code: 'FR', nom: 'Fribourg' }, { code: 'JU', nom: 'Jura' },
];
const ROMANDS = new Set(CANTONS.map((c) => c.code));
const MOIS_FR: Record<string, string> = { '01': 'janvier', '02': 'février', '03': 'mars', '04': 'avril', '05': 'mai', '06': 'juin', '07': 'juillet', '08': 'août', '09': 'septembre', '10': 'octobre', '11': 'novembre', '12': 'décembre' };
const DEBUT = '2026-08'; // premier mois complet (juillet partiel exclu)

// Clé commune normalisée (accents, Saint/St, ponctuation) pour relier la sélection aux données
const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
  .replace(/\bsaint(e)?\b/g, (m) => (m.endsWith('e') ? 'ste' : 'st')).replace(/[^a-z0-9]/g, '');

const exclus = new Set((doublons as any).exclus as string[]);
const cle = (e: any) => [e.commune, (e.dateVue || '').slice(0, 10), e.titre].join(' | ');
const parts = new Intl.DateTimeFormat('fr-CH', { timeZone: 'Europe/Zurich', year: 'numeric', month: '2-digit' }).formatToParts(new Date());
const moisCourant = `${parts.find((p) => p.type === 'year')!.value}-${parts.find((p) => p.type === 'month')!.value}`;

const perCommune: Record<string, { k: string; parMois: Record<string, { d: string; cat: string; t: string; s: string }[]> }> = {};
const cantonParMois: Record<string, Record<string, number>> = {};
const moisSet = new Set<string>();
for (const e of archive.evenements as any[]) {
  const m = (e.dateVue || '').slice(0, 7);
  if (!ROMANDS.has(e.canton) || m < DEBUT || m === moisCourant || exclus.has(cle(e))) continue;
  moisSet.add(m);
  (cantonParMois[e.canton] ||= {})[m] = ((cantonParMois[e.canton] ||= {})[m] || 0) + 1;
  const k = norm(e.commune);
  const rec = (perCommune[k] ||= { k: e.canton, parMois: {} });
  (rec.parMois[m] ||= []).push({ d: (e.dateVue || '').slice(8, 10) + '.' + (e.dateVue || '').slice(5, 7), cat: e.categorie, t: e.titre, s: e.source || '' });
}
const mois = [...moisSet].sort();
const dernierMois = mois[mois.length - 1] || DEBUT;
const dernierLabel = `${MOIS_FR[dernierMois.slice(5)]} ${dernierMois.slice(0, 4)}`;

const reportData = { perCommune, cantonParMois, dernierMois, dernierLabel, communes: COMMUNES };
---

<section class="rc" id="rapport">
  <div class="container">
    <div class="rc-card">
      <div class="rc-visual" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="26" height="26">
          <path d="M6 2h8l6 6v14H6z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" />
        </svg>
      </div>
      <div class="rc-main">
        <span class="rc-eyebrow">Rapport de sécurité · gratuit</span>
        <h2>Le rapport de sécurité de votre commune</h2>
        <p class="rc-desc">Choisissez votre commune pour voir le bilan du mois - puis recevez-le chaque mois par e-mail.</p>

        <div id="rc-step1">
          <div class="rc-row">
            <label class="rc-field">
              <span>Votre canton</span>
              <select id="rc-canton" aria-label="Votre canton">
                <option value="" disabled selected>Choisir…</option>
                {CANTONS.map((c) => <option value={c.code}>{c.nom}</option>)}
              </select>
            </label>
            <label class="rc-field">
              <span>Votre commune</span>
              <select id="rc-commune" aria-label="Votre commune" disabled>
                <option value="" disabled selected>Choisissez d'abord le canton</option>
              </select>
              <input type="text" id="rc-commune-autre" placeholder="Nom de votre commune" autocomplete="address-level2" aria-label="Nom de votre commune" hidden />
            </label>
          </div>
          <button type="button" id="rc-voir" class="btn btn-primary rc-submit">Voir le rapport de ma commune</button>
        </div>

        <div id="rc-report" hidden>
          <button type="button" id="rc-retour" class="rc-retour">&#8592; Changer de commune</button>
          <div id="rc-report-body"></div>

          <div class="rc-sub" id="rc-sub">
            <p class="rc-sub-title">Recevez le rapport de <b id="rc-sub-commune"></b> chaque mois</p>
            <form class="rc-subform" id="rc-subform" novalidate>
              <input type="email" name="EMAIL" placeholder="votre@email.ch" autocomplete="email" aria-label="Votre e-mail" required />
              <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="rc-hp" />
              <button type="submit" class="btn btn-primary">Recevoir chaque mois</button>
            </form>
            <p class="rc-privacy">Gratuit, un envoi par mois. En vous inscrivant, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>. Désinscription en un clic.</p>
          </div>
        </div>

        <div id="rc-success" hidden>
          <p class="rc-thanks" id="rc-thanks">Merci ! Votre prochain rapport arrivera par e-mail.</p>
          <p class="rc-next">En attendant, <a href="/#telecharger">téléchargez l'application Edgward</a> pour être alerté dès qu'un événement survient près de chez vous.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="rc-data" set:html={JSON.stringify(reportData)}></script>

<script>
  const D = JSON.parse(document.getElementById('rc-data').textContent);
  const CATS = {
    cambriolage: { l: 'Cambriolages', c: '#f59e0b' }, agression: { l: 'Agressions', c: '#ef4444' },
    incendie: { l: 'Incendies', c: '#fb7a3c' }, accident: { l: 'Accidents', c: '#2563eb' },
    disparition: { l: 'Disparitions', c: '#8b5cf6' }, ordre: { l: 'Ordre public', c: '#0891b2' }, cyber: { l: 'Cyber', c: '#059669' },
  };
  const CANTONS = { GE: 'Genève', VD: 'Vaud', VS: 'Valais', NE: 'Neuchâtel', FR: 'Fribourg', JU: 'Jura' };
  const BREVO_ACTION = ''; // À REMPLACER par l'URL du formulaire Brevo (attributs CANTON + COMMUNE, double opt-in).
  const DELAI_MIN_MS = 1500;
  const chargeA = Date.now();
  const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
  const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\bsaint(e)?\b/g, (m) => (m.endsWith('e') ? 'ste' : 'st')).replace(/[^a-z0-9]/g, '');

  const step1 = document.getElementById('rc-step1');
  const report = document.getElementById('rc-report');
  const reportBody = document.getElementById('rc-report-body');
  const success = document.getElementById('rc-success');
  const thanks = document.getElementById('rc-thanks');
  const cantonSel = document.getElementById('rc-canton');
  const communeSel = document.getElementById('rc-commune');
  const communeAutre = document.getElementById('rc-commune-autre');
  const subCommune = document.getElementById('rc-sub-commune');
  let choix = { canton: '', commune: '' };

  cantonSel.addEventListener('change', () => {
    const list = D.communes[cantonSel.value] || [];
    communeSel.innerHTML = '<option value="" disabled selected>Choisir…</option>'
      + list.map((c) => '<option>' + c + '</option>').join('')
      + '<option value="_autre">Ma commune n\'est pas dans la liste…</option>';
    communeSel.disabled = false;
    communeAutre.hidden = true; communeAutre.value = '';
  });
  communeSel.addEventListener('change', () => {
    const autre = communeSel.value === '_autre';
    communeAutre.hidden = !autre;
    if (autre) communeAutre.focus();
  });

  function resoudreCommune() {
    let c = communeSel.value;
    if (c === '_autre') c = communeAutre.value.trim();
    return c;
  }

  document.getElementById('rc-voir').addEventListener('click', () => {
    const canton = cantonSel.value;
    const commune = resoudreCommune();
    if (!canton) { cantonSel.focus(); return; }
    if (!commune) { (communeSel.value === '_autre' ? communeAutre : communeSel).focus(); return; }
    choix = { canton, commune };
    reportBody.innerHTML = construireRapport(canton, commune);
    subCommune.textContent = commune;
    step1.hidden = true; report.hidden = false;
    report.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('rc-retour').addEventListener('click', () => {
    report.hidden = true; step1.hidden = false;
  });

  function construireRapport(canton, commune) {
    const rec = D.perCommune[norm(commune)];
    const evs = (rec && rec.k === canton && rec.parMois[D.dernierMois]) ? rec.parMois[D.dernierMois] : [];
    const cantonTot = (D.cantonParMois[canton] && D.cantonParMois[canton][D.dernierMois]) || 0;
    let h = '<div class="rc-rhead"><span class="rc-rtag">Rapport de sécurité</span>'
      + '<div class="rc-rtitle">' + esc(commune) + '</div><div class="rc-rmo">' + D.dernierLabel + '</div></div>';
    if (evs.length) {
      h += '<p class="rc-rlead"><b>' + evs.length + '</b> événement' + (evs.length > 1 ? 's' : '') + ' de sécurité recensé' + (evs.length > 1 ? 's' : '') + ' à ' + esc(commune) + ' en ' + D.dernierLabel + '.</p>';
      h += '<div class="rc-evs">' + evs.map((e) => { const c = CATS[e.cat] || { l: e.cat, c: '#64748b' };
        return '<div class="rc-ev"><span class="rc-ev-d">' + e.d + '</span><span class="rc-ev-b"><span class="rc-ev-t">' + esc(e.t) + '</span>' + (e.s ? '<span class="rc-ev-s">' + esc(e.s) + '</span>' : '') + '</span><span class="rc-ev-c" style="color:' + c.c + '">' + c.l + '</span></div>';
      }).join('') + '</div>';
    } else {
      h += '<p class="rc-rlead rc-rcalm">Aucun événement de sécurité relayé à ' + esc(commune) + ' en ' + D.dernierLabel + '. Un mois calme, selon les sources publiques.</p>';
    }
    h += '<p class="rc-rctx">Dans le canton de ' + esc(CANTONS[canton] || canton) + ' : <b>' + cantonTot + '</b> événement' + (cantonTot > 1 ? 's' : '') + ' recensé' + (cantonTot > 1 ? 's' : '') + ' en ' + D.dernierLabel + '. Données neutres, dédoublonnées, sans information personnelle.</p>';
    return h;
  }

  function reveal() {
    thanks.textContent = 'Merci ! Le rapport de ' + choix.commune + ' vous sera envoyé chaque mois par e-mail.';
    report.hidden = true; success.removeAttribute('hidden');
  }

  document.getElementById('rc-subform').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target;
    if (f.email_address_check.value) return;
    if (Date.now() - chargeA < DELAI_MIN_MS) return;
    const email = f.EMAIL.value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { f.EMAIL.focus(); f.EMAIL.reportValidity(); return; }
    const btn = f.querySelector('button[type="submit"]');
    btn.disabled = true; btn.textContent = 'Envoi…';
    const done = () => { reveal(); window.gtag?.('event', 'rapport_commune_inscription', { canton: choix.canton, commune: choix.commune }); };
    if (!BREVO_ACTION) { done(); return; }
    const params = new URLSearchParams();
    params.append('EMAIL', email);
    params.append('CANTON', choix.canton);
    params.append('COMMUNE', choix.commune);
    params.append('email_address_check', '');
    params.append('locale', 'fr');
    fetch(BREVO_ACTION, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() })
      .catch(() => {}).finally(done);
  });
</script>

<style>
  .rc { padding: 8px 0 0; }
  .rc-card {
    max-width: 760px; margin: 0 auto; display: flex; gap: 20px;
    background: var(--brand-soft); border: 1px solid rgba(70, 120, 220, 0.22);
    border-left: 3px solid var(--brand); border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 28px;
  }
  .rc-visual { flex: none; width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius); background: #fff; color: var(--brand); border: 1px solid rgba(70,120,220,.2); }
  .rc-main { flex: 1; min-width: 0; }
  .rc-eyebrow { display: block; font-size: 11px; font-weight: 700; color: var(--brand); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
  .rc-main h2 { font-size: 21px; font-weight: 800; color: var(--navy); line-height: 1.25; letter-spacing: -.02em; margin: 0 0 8px; }
  .rc-desc { font-size: 14px; line-height: 1.6; color: var(--text-muted); margin: 0 0 18px; }
  .rc-row { display: flex; gap: 10px; margin-bottom: 12px; }
  .rc-field { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .rc-field span { font-size: 12px; font-weight: 600; color: var(--text-muted); }
  .rc-field select, .rc-field input { width: 100%; padding: 11px 14px; font-family: inherit; font-size: 14px; color: var(--navy); background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .rc-field select:focus, .rc-field input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .rc-submit { align-self: flex-start; }
  .rc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .rc-privacy { font-size: 12px; color: var(--text-light); line-height: 1.5; margin: 10px 0 0; }
  .rc-privacy a { color: var(--text-muted); text-decoration: underline; }
  .rc-thanks { font-size: 15px; font-weight: 700; color: var(--navy); margin: 0 0 8px; }
  .rc-next { font-size: 13px; color: var(--text-muted); margin: 0; }
  .rc-next a, .rc-sub-title b { color: var(--brand); }

  /* Rapport affiché */
  .rc-retour { background: none; border: 0; color: var(--brand); font-family: inherit; font-weight: 700; font-size: 13px; cursor: pointer; padding: 0; margin: 0 0 12px; }
  .rc-rhead { border-bottom: 2px solid var(--navy); padding-bottom: 10px; margin-bottom: 12px; }
  .rc-rtag { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: var(--brand); font-weight: 800; }
  .rc-rtitle { font-size: 24px; font-weight: 800; color: var(--navy); line-height: 1.1; letter-spacing: -.02em; }
  .rc-rmo { font-size: 13px; color: var(--text-muted); text-transform: capitalize; }
  .rc-rlead { font-size: 14px; color: var(--navy); margin: 0 0 12px; }
  .rc-rcalm { color: var(--text-muted); }
  .rc-evs { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .rc-ev { display: flex; gap: 11px; padding: 10px 13px; border-top: 1px solid var(--border); font-size: 13px; }
  .rc-ev:first-child { border-top: 0; }
  .rc-ev-d { flex: 0 0 38px; color: var(--text-light); font-weight: 600; font-variant-numeric: tabular-nums; }
  .rc-ev-b { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rc-ev-t { font-weight: 700; color: var(--navy); line-height: 1.3; }
  .rc-ev-s { color: var(--text-muted); font-size: 11px; margin-top: 1px; }
  .rc-ev-c { flex: 0 0 auto; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; font-weight: 800; align-self: flex-start; }
  .rc-rctx { font-size: 12.5px; color: var(--text-muted); margin: 12px 0 0; line-height: 1.5; }

  .rc-sub { margin-top: 20px; padding-top: 18px; border-top: 1px dashed rgba(70,120,220,.3); }
  .rc-sub-title { font-size: 15px; font-weight: 700; color: var(--navy); margin: 0 0 10px; }
  .rc-subform { display: flex; gap: 8px; }
  .rc-subform input[type="email"] { flex: 1; min-width: 0; padding: 11px 14px; font-family: inherit; font-size: 14px; color: var(--navy); background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .rc-subform input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .rc-subform button { flex: none; white-space: nowrap; }

  @media (max-width: 600px) {
    .rc-card { flex-direction: column; gap: 16px; padding: 24px 20px; }
    .rc-row { flex-direction: column; }
    .rc-submit { width: 100%; justify-content: center; }
    .rc-subform { flex-direction: column; }
    .rc-subform button { width: 100%; justify-content: center; }
  }
</style>
