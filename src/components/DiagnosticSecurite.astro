---
/**
 * Diagnostic sécurité — questionnaire adaptatif « conseiller honnête ».
 * Rendu inline (page) ou dans un overlay. Chaque instance est initialisée
 * par le script global via la racine `.edg-diag`.
 *
 * Props :
 *  - source        : étiquette du point d'entrée (page / flottant / hero / page-nyon…), remontée à GA4 + journal
 *  - prefillCanton : GE | VD | NE | romand | autre — saute la question canton
 *  - endpoint      : URL /exec du webhook Apps Script (vide = journal désactivé)
 *  - secret        : jeton partagé anti-spam envoyé au webhook
 */
interface Props {
  source?: string;
  prefillCanton?: string;
  endpoint?: string;
  secret?: string;
  /** Ne s'initialise pas au chargement ; attend un event edg-diag:mount ciblé (overlay). */
  defer?: boolean;
  /** Retire le cadre du panneau (utile quand le composant vit déjà dans une modale). */
  bare?: boolean;
}
const {
  source = 'page',
  prefillCanton = '',
  endpoint = '',
  secret = '',
  defer = false,
  bare = false,
} = Astro.props;
---

<div
  class:list={['edg-diag', bare && 'edg-diag--bare']}
  data-source={source}
  data-prefill-canton={prefillCanton}
  data-endpoint={endpoint}
  data-secret={secret}
  data-defer={defer ? '1' : undefined}
>
  <div class="edg-diag-panel">
    <div class="edg-diag-top">
      <div class="edg-diag-steps" aria-hidden="true"></div>
      <div class="edg-diag-head"></div>
    </div>
    <div class="edg-diag-body" aria-live="polite"></div>
  </div>
</div>

<style is:global>
  .edg-diag { --d-good:#0E9E6A; --d-good-tint:#E6F6EF; --d-warn:#C7841B; --d-warn-tint:#FBF1DE;
    max-width: 560px; margin: 0 auto; }
  .edg-diag-panel {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgba(10,25,41,.04), 0 18px 40px -18px rgba(10,25,41,.18); overflow: hidden;
  }
  .edg-diag--bare { max-width: none; }
  .edg-diag--bare .edg-diag-panel { border: none; box-shadow: none; border-radius: 0; }
  .edg-diag-top { padding: 20px 24px 0; }
  .edg-diag-steps { display: flex; gap: 5px; margin-bottom: 20px; }
  .edg-diag-steps i { height: 4px; flex: 1; border-radius: 99px; background: var(--border); transition: background .35s ease; }
  .edg-diag-steps i.done { background: var(--brand); }
  .edg-diag-steps i.cur { background: var(--brand); opacity: .4; }

  .edg-diag .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
  .edg-diag h3.q { font-family:'Manrope',sans-serif; font-size: clamp(20px,4.6vw,24px); line-height: 1.2; letter-spacing: -.02em; margin: 0 0 6px; font-weight: 800; color: var(--navy); text-wrap: balance; }
  .edg-diag .sub { margin: 0; color: var(--text-muted); font-size: 14px; line-height: 1.5; }
  .edg-diag-body { padding: 18px 24px 26px; }

  .edg-diag .opts { display: grid; gap: 9px; }
  .edg-diag .opt {
    display: flex; align-items: center; gap: 13px; width: 100%; text-align: left; cursor: pointer;
    background: #fff; border: 1.5px solid var(--border); border-radius: var(--radius); padding: 13px 14px;
    font-family: inherit; color: var(--text); transition: border-color .15s, background .15s, transform .06s;
  }
  .edg-diag .opt:hover { border-color: var(--brand); background: var(--brand-soft); }
  .edg-diag .opt:active { transform: scale(.99); }
  .edg-diag .opt .ic { flex: none; width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }
  .edg-diag .opt .ic svg { width: 19px; height: 19px; }
  .edg-diag .opt .tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .edg-diag .opt .tx b { font-weight: 700; font-size: 15px; letter-spacing: -.01em; }
  .edg-diag .opt .tx small { color: var(--text-light); font-size: 12.5px; line-height: 1.35; }
  .edg-diag .opt .arw { margin-left: auto; color: var(--border); flex: none; }
  .edg-diag .opt:hover .arw { color: var(--brand); }

  .edg-diag .back { background: none; border: none; cursor: pointer; font-family: inherit; color: var(--text-light);
    font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; padding: 6px 0; margin-bottom: 4px; }
  .edg-diag .back:hover { color: var(--navy); }

  .edg-diag .badge { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 700; letter-spacing: .02em; padding: 6px 12px; border-radius: 99px; margin-bottom: 14px; }
  .edg-diag .v-fit { background: var(--brand-soft); color: var(--brand-dark); }
  .edg-diag .v-free { background: var(--d-good-tint); color: var(--d-good); }
  .edg-diag .v-soon { background: var(--d-warn-tint); color: var(--d-warn); }
  .edg-diag .v-part { background: var(--soft); color: var(--text-muted); }

  .edg-diag h3.res { font-family:'Manrope',sans-serif; font-size: clamp(22px,5vw,27px); line-height: 1.18; letter-spacing: -.02em; margin: 0 0 12px; font-weight: 800; color: var(--navy); text-wrap: balance; }
  .edg-diag .res-p { color: var(--text-muted); font-size: 14.5px; line-height: 1.6; margin: 0 0 14px; }
  .edg-diag .res-p strong { color: var(--navy); font-weight: 700; }

  .edg-diag .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 18px; }
  .edg-diag .chip { font-size: 12px; font-weight: 600; color: var(--text-muted); background: var(--soft); border: 1px solid var(--border); padding: 5px 10px; border-radius: 8px; }

  .edg-diag .note { display: flex; gap: 10px; align-items: flex-start; border-radius: var(--radius); padding: 12px 14px; margin: 0 0 18px; font-size: 13.5px; line-height: 1.5; color: var(--text); }
  .edg-diag .note svg { flex: none; margin-top: 1px; }
  .edg-diag .note.good { background: var(--d-good-tint); } .edg-diag .note.good svg { color: var(--d-good); } .edg-diag .note.good b { color: var(--d-good); }
  .edg-diag .note.blue { background: var(--brand-soft); } .edg-diag .note.blue svg { color: var(--brand); } .edg-diag .note.blue b { color: var(--brand-dark); }
  .edg-diag .note.warn { background: var(--d-warn-tint); } .edg-diag .note.warn svg { color: var(--d-warn); } .edg-diag .note.warn b { color: var(--d-warn); }

  .edg-diag .partners { display: flex; flex-wrap: wrap; gap: 7px; margin: 2px 0 20px; }
  .edg-diag .partners span { font-size: 13px; font-weight: 700; color: var(--navy); background: var(--soft); border: 1px solid var(--border); padding: 7px 12px; border-radius: 9px; }

  .edg-diag .ctas { display: grid; gap: 10px; }
  .edg-diag .cta { display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; cursor: pointer;
    font-family: inherit; font-size: 15px; font-weight: 700; letter-spacing: -.01em; padding: 14px 18px; border-radius: var(--radius); border: 1.5px solid transparent; transition: transform .06s, background .15s, box-shadow .2s; }
  .edg-diag .cta:active { transform: scale(.99); }
  .edg-diag .cta-primary { background: var(--brand); color: #fff; box-shadow: 0 1px 2px rgba(70,120,220,.25); }
  .edg-diag .cta-primary:hover { background: var(--brand-dark); box-shadow: 0 6px 16px rgba(70,120,220,.3); }
  .edg-diag .cta-ghost { background: #fff; color: var(--navy); border-color: var(--border); }
  .edg-diag .cta-ghost:hover { border-color: var(--brand); color: var(--brand); }

  .edg-diag .edg-wait { display: flex; gap: 8px; }
  .edg-diag .edg-wait-input {
    flex: 1 1 auto; min-width: 0; border: 1.5px solid var(--border); border-radius: var(--radius);
    padding: 12px 14px; font-family: inherit; font-size: 15px; color: var(--text); background: #fff;
  }
  .edg-diag .edg-wait-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .edg-diag .edg-wait .cta { flex: none; white-space: nowrap; }
  .edg-diag .edg-wait-ok { display: flex; align-items: center; gap: 7px; font-size: 13.5px; font-weight: 600; color: var(--d-good); margin: 6px 2px 0; }
  @media (max-width: 420px) { .edg-diag .edg-wait { flex-direction: column; } }

  .edg-diag .restart { background: none; border: none; cursor: pointer; font-family: inherit; color: var(--text-light);
    font-size: 13px; font-weight: 600; margin-top: 18px; display: inline-flex; align-items: center; gap: 6px; }
  .edg-diag .restart:hover { color: var(--navy); }

  .edg-diag .fade { animation: edgDiagFade .32s ease; }
  @keyframes edgDiagFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .edg-diag .fade { animation: none; } .edg-diag-steps i { transition: none; } }
</style>

<script>
  type State = Record<string, string>;
  interface Opt { v: string; icon: string; t: string; d?: string; }
  interface Q { key: string; q: string; sub: string; when?: (s: State) => boolean; opts: Opt[]; }

  const ic: Record<string, string> = {
    home:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/></svg>',
    shop:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9 5 4h14l1 5"/><path d="M4 9v11h16V9"/><path d="M4 9a2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0"/><path d="M9.5 20v-5h5v5"/></svg>',
    building:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 7h2M8 11h2M8 15h2M14 7h2M14 11h2M14 15h2"/></svg>',
    crane:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V5l14-1"/><path d="M5 8h14"/><path d="M9 8v3"/><path d="M4 21h6"/><path d="M18 4v6"/><path d="M18 10a1.5 1.5 0 0 0 0 3"/></svg>',
