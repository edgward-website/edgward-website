---
// Formulaire sur-mesure investisseurs / partenaires (parcours F).
// Reutilise l'endpoint Brevo du contact classique : le profil et l'organisation sont composes
// dans le message et le sujet est "Autre" (5). Pas de reconfiguration Brevo necessaire.
const profils = ['Investisseur', 'Partenaire stratégique', 'Société de sécurité', 'Autre'];
---

<div class="inv-form-wrap">
  <form class="inv-form" novalidate id="investor-form">
    <div class="inv-row">
      <div class="inv-group">
        <label for="if-nom">Nom complet</label>
        <input type="text" id="if-nom" name="nom" placeholder="Jean Dupont" autocomplete="name" required>
      </div>
      <div class="inv-group">
        <label for="if-email">Email</label>
        <input type="email" id="if-email" name="email" placeholder="jean@example.ch" autocomplete="email" required>
      </div>
    </div>
    <div class="inv-row">
      <div class="inv-group">
        <label for="if-org">Organisation <span class="inv-opt">(optionnel)</span></label>
        <input type="text" id="if-org" name="organisation" placeholder="Société, fonds, institution" autocomplete="organization">
      </div>
      <div class="inv-group">
        <label for="if-profil">Vous êtes</label>
        <select id="if-profil" name="profil" required>
          <option value="" disabled selected>Choisissez votre profil</option>
          {profils.map(p => <option value={p}>{p}</option>)}
        </select>
      </div>
    </div>
    <div class="inv-group">
      <label for="if-message">Message <span class="inv-opt">(optionnel)</span></label>
      <textarea id="if-message" name="message" rows="4" placeholder="Votre intérêt, votre horizon, votre proposition..."></textarea>
    </div>
    <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="inv-hp">
    <button type="submit" class="inv-submit">
      Échanger avec le fondateur
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
    <p class="inv-privacy">En envoyant ce message, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>.</p>
  </form>
  <div class="inv-success" id="investor-success" hidden>
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
    <h3>Message envoyé&nbsp;!</h3>
    <p>Merci pour votre intérêt. Daniel vous répondra personnellement dans les meilleurs délais.</p>
  </div>
</div>

<script>
  const form = document.getElementById('investor-form') as HTMLFormElement | null;
  const successBox = document.getElementById('investor-success');
  const BREVO_CONTACT_ACTION = 'https://87714af1.sibforms.com/serve/MUIFACeUMEzMccQ08jYHlzrdNpWoRrnKzHQmfX53dXh3078PAXXC3bDI0rzN0FcL7yQIGvijOqpaNaHdOjgoOWJ0h_xT7KN4dQy7e-dZ-47FALbyi6DffXwBux4VqYLN-Z7VKjeO_D3znDM-oK3wufPUoBSGyWitQx2h1rhHU_u3hjMH8qe9N4GbLlzOUn60ndvujAgptth1dR8i';
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const honeypot = (form.elements.namedItem('email_address_check') as HTMLInputElement)?.value;
    if (honeypot) return;
    const data = new FormData(form);
    const nom = String(data.get('nom') || '').trim();
    const email = String(data.get('email') || '').trim();
    const organisation = String(data.get('organisation') || '').trim();
    const profil = String(data.get('profil') || '');
    const message = String(data.get('message') || '').trim();
    if (!form.checkValidity() || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      form.reportValidity();
      return;
    }
    const btn = form.querySelector('.inv-submit') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';
    let composed = '[Investisseurs/Partenaires] Profil : ' + (profil || 'non precise');
    if (organisation) composed += ' - Organisation : ' + organisation;
    if (message) composed += ' - ' + message;
    composed = composed.slice(0, 255);
    const params = new URLSearchParams();
    params.append('NOM', nom);
    params.append('EMAIL', email);
    params.append('SUJET', '5');
    params.append('MESSAGE', composed);
    params.append('email_address_check', '');
    params.append('locale', 'en');
    fetch(BREVO_CONTACT_ACTION, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params,
      keepalive: true,
    }).catch(() => {});
    if (successBox) {
      form.hidden = true;
      successBox.hidden = false;
      successBox.setAttribute('tabindex', '-1');
      (successBox as HTMLElement).focus();
      (successBox as HTMLElement).scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  });
</script>

<style>
  .inv-form-wrap { width: 100%; }
  .inv-form { display: flex; flex-direction: column; gap: 16px; }
  .inv-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .inv-group { display: flex; flex-direction: column; gap: 6px; }
  .inv-form label { font-size: 13px; font-weight: 600; color: var(--navy); }
  .inv-opt { font-weight: 400; color: var(--text-muted); }
  .inv-form input, .inv-form select, .inv-form textarea {
    border: 1px solid var(--border); border-radius: var(--radius); padding: 11px 13px;
    font-size: 14px; font-family: inherit; color: var(--text); background: white; outline: none;
    transition: border-color 0.2s ease;
  }
  .inv-form input:focus, .inv-form select:focus, .inv-form textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .inv-form textarea { resize: vertical; min-height: 96px; }
  .inv-submit {
    background: var(--brand); color: white; padding: 13px 22px; border-radius: 10px;
    font-size: 15px; font-weight: 600; border: none; cursor: pointer; font-family: inherit;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: all 0.2s ease; box-shadow: 0 1px 3px rgba(70,120,220,0.3); align-self: flex-start;
  }
  .inv-submit:hover { background: var(--brand-dark); transform: translateY(-2px); }
  .inv-submit:disabled { opacity: 0.7; cursor: default; transform: none; }
  .inv-privacy { font-size: 12px; color: var(--text-muted); margin: 0; }
  .inv-privacy a { color: var(--brand); text-decoration: none; }
  .inv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .inv-form[hidden] { display: none; }
  .inv-success { text-align: center; padding: 40px 24px; }
  .inv-success[hidden] { display: none; }
  .inv-success svg { color: var(--brand); margin-bottom: 12px; }
  .inv-success h3 { font-size: 20px; font-weight: 700; color: var(--navy); margin-bottom: 8px; }
  .inv-success p { font-size: 14px; color: var(--text-muted); line-height: 1.6; max-width: 380px; margin: 0 auto; }

  @media (max-width: 600px) {
    .inv-row { grid-template-columns: 1fr; }
    .inv-submit { width: 100%; }
  }
</style>
