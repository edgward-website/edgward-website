---
// Bloc de conversion B2C en fin d'article de blog. Active par `ctaB2C: true`.
// Carte claire posee sur une bande claire : le bloc doit se detacher du pied de page,
// qui est sombre. Une seule action principale, un seul argument, le reste en petit.
// L'accroche peut etre reprise du sujet de l'article via `ctaTitre` / `ctaAccroche`.
// Le suivi des clics est pose une fois pour toutes dans src/pages/blog/[slug].astro.
import { site } from '../data/site';

interface Props {
  titre?: string;
  accroche?: string;
}

const {
  titre = "Un doute, une absence, une alerte ? <em>On passe vérifier.</em>",
  accroche = "Un agent partenaire se déplace à votre adresse quand vous le décidez, vous suivez l'intervention et vous recevez un rapport. Rien à installer, sans engagement.",
} = Astro.props;
---

<section class="blog-cta-hot" data-cta-blog>
  <div class="container">
    <div class="bch-carte fade-in">
      <div class="bch-texte">
        <span class="bch-pastille">Premier mois offert</span>
        <h2 set:html={titre} />
        <p class="bch-lead">{accroche}</p>

        <a href={site.apps.appStore} class="bch-action" data-cta-dest="app_store" data-cta-emplacement="fin" target="_blank" rel="noopener noreferrer">
          Télécharger l'application
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>

        <div class="bch-stores">
          <a href={site.apps.appStore} class="bch-store" data-cta-dest="app_store_lien" data-cta-emplacement="fin" target="_blank" rel="noopener noreferrer">App Store</a>
          <a href={site.apps.playStore} class="bch-store" data-cta-dest="google_play" data-cta-emplacement="fin" target="_blank" rel="noopener noreferrer">Google Play</a>
        </div>

        <p class="bch-petit">
          Déjà une alarme ? Edgward fait la levée de doute, sans doublon.
          <a href="/intervention-alarme" data-cta-dest="intervention_alarme" data-cta-emplacement="fin">Voir comment</a>
        </p>
      </div>

      <img class="bch-ed" src="/assets/ed-pouce.png" alt="" aria-hidden="true" width="132" height="165" loading="lazy">
    </div>
  </div>
</section>

<style>
  .blog-cta-hot { background: #eef3fb; padding: 56px 0; }

  .bch-carte {
    max-width: 680px; margin: 0 auto; background: white;
    border: 1px solid var(--border); border-radius: 18px;
    box-shadow: 0 14px 40px rgba(10, 25, 41, 0.09);
    padding: 32px 34px; display: flex; gap: 28px; align-items: center;
  }
  .bch-texte { flex: 1 1 auto; min-width: 0; }

  .bch-pastille {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--brand-soft); color: #345fb4;
    font-size: 12px; font-weight: 700; letter-spacing: 0.03em;
    padding: 5px 12px; border-radius: 100px; margin-bottom: 14px;
  }
  .bch-pastille::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }

  .bch-carte h2 {
    font-size: clamp(21px, 2.8vw, 27px); font-weight: 800; line-height: 1.2;
    letter-spacing: -0.02em; color: var(--navy); margin: 0 0 11px; text-wrap: balance;
  }
  .bch-carte h2 :global(em) { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand); }

  .bch-lead { font-size: 15px; line-height: 1.6; color: var(--text-muted); margin: 0 0 20px; }

  .bch-action {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--brand); color: white; font-size: 15.5px; font-weight: 700;
    padding: 14px 26px; border-radius: 12px; text-decoration: none;
    box-shadow: 0 6px 18px rgba(70, 120, 220, 0.35);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .bch-action:hover { background: var(--brand-dark); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(70, 120, 220, 0.42); }

  .bch-stores { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 14px; }
  .bch-store { font-size: 12.5px; font-weight: 600; color: var(--text-muted); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 2px; }
  .bch-store:hover { color: var(--brand); border-color: var(--brand); }

  .bch-petit { font-size: 12.5px; line-height: 1.55; color: var(--text-light); margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--border); }
  .bch-petit a { color: #345fb4; font-weight: 600; text-decoration: none; }
  .bch-petit a:hover { text-decoration: underline; }

  .bch-ed { flex: 0 0 auto; width: 132px; height: auto; }

  @media (max-width: 620px) {
    .blog-cta-hot { padding: 40px 0; }
    .bch-carte { flex-direction: column; align-items: flex-start; padding: 26px 22px; gap: 20px; }
    .bch-ed { width: 100px; align-self: center; }
  }
</style>
