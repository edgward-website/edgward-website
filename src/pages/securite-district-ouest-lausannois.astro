---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import LocalNextStep from '../components/LocalNextStep.astro';
import Testimonials from '../components/Testimonials.astro';
import PartnersGrid from '../components/PartnersGrid.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { partners } from '../data/partners';

// --- Données propres au district ---
// Chiffres officiels 2025 - Statistique policière de la criminalité, Police cantonale vaudoise (vd.ch).
const chiffres = [
  {
    "num": "675",
    "label": "cambriolages par effraction (+16,2% vs 2024)"
  },
  {
    "num": "124",
    "label": "introductions clandestines"
  },
  {
    "num": "543",
    "label": "dommages à la propriété"
  },
  {
    "num": "4'849",
    "label": "infractions contre le patrimoine"
  }
];

const vaudNames = ['Wolfguard', 'Global Sécurité (SPS)', 'GPA SA', 'Roc Sécurité', 'Juggers'];
const partenairesVD = partners.filter(p => vaudNames.includes(p.name));

const temoignages = [
  {
    quote: "Budget vraiment intéressant pour ma boutique. Installation et application largement meilleur marché qu'avec un système relié à un opérateur dédié.",
    name: 'Luc S.',
    role: 'Commerçant à Lausanne',
    initials: 'LS',
    stars: 4,
  },
  {
    quote: "L'application est vraiment utile avec son système d'information gratuit, et en cas d'événement à mon domicile. Je cherchais un complément à mes caméras : l'abonnement à CHF 15.-/mois est imbattable.",
    name: 'Gwendoline F.',
    role: 'Cliente à Nyon',
    initials: 'GF',
  },
  {
    quote: "Une installation complète des caméras et des panneaux, avec une explication détaillée de l'utilisation de l'application Edgward, vraiment top !",
    name: 'Aline E.',
    role: 'Cliente à Tannay',
    initials: 'AE',
  },
];

const faq = [
  {
    "question": "Edgward est-il disponible dans le district de l'Ouest lausannois ?",
    "answer": "Oui. Edgward couvre votre secteur grâce à ses sociétés de sécurité partenaires vaudoises. Vous recevez les alertes vérifiées près de chez vous et pouvez faire intervenir une patrouille à la demande, sans abonnement de gardiennage."
  },
  {
    "question": "Le district de l'Ouest lausannois est-il très touché par les cambriolages ?",
    "answer": "Oui : avec 675 cambriolages par effraction en 2025, en hausse de 16%, l'Ouest lausannois est le district le plus touché du canton hors Lausanne. La densité urbaine (Renens, Crissier, Prilly) explique ce niveau, avec beaucoup de faits dans les caves et parkings d'immeubles. Edgward vous alerte et permet d'agir vite."
  },
  {
    "question": "Quelles communes sont couvertes dans le district de l'Ouest lausannois ?",
    "answer": "L'ensemble des 8 communes du district est couvert par le réseau de sociétés de sécurité partenaires. Le tableau de cette page reprend les chiffres officiels 2025 des communes les plus concernées."
  },
  {
    "question": "Combien coûte Edgward et comment l'activer ?",
    "answer": "Les alertes et informations de sécurité sont 100% gratuites. L'abonnement complet est à CHF 15.-/mois, et vous ne payez une intervention que si vous en commandez une. Il suffit de télécharger l'application, d'indiquer votre adresse et d'activer les alertes."
  }
];
---

<Base
  title="Sécurité dans le district de l'Ouest lausannois : alertes et intervention | Edgward"
  description="675 cambriolages par effraction dans le district de l'Ouest lausannois en 2025 (+16,2% sur un an). Suivez les alertes vérifiées de votre commune et faites intervenir une patrouille à la demande."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <img class="canton-flag" src="/assets/flag-vaud.png" width="22" height="22" alt="" aria-hidden="true">
            District de l'Ouest lausannois · Canton de Vaud
          </div>
          <h1>La sécurité dans le<br><em>district de l'Ouest lausannois</em></h1>
          <p>Suivez ce qui se passe réellement près de chez vous <strong>et</strong> faites intervenir une patrouille à la demande, l'agglomération à l'ouest de Lausanne. Alertes géolocalisées vérifiées et gratuites, sans engagement.</p>
          <div class="hero-ctas">
            <a href="#chiffres" class="btn-primary">
              Voir les chiffres 2025
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/securite-vaud" class="btn-secondary">
              Voir tout le canton de Vaud
            </a>
          </div>
          <p class="hero-note">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Découvrez le <a href="/alertes">module Alertes &amp; Informations</a> ou nos solutions pour <a href="/entreprises">entreprises</a>. Vous avez une alarme ? Voyez l’<a href="/intervention-alarme">intervention sur alarme</a>.
          </p>
        </div>
        <div class="hero-visual">
          <div class="newsfeed-demo" aria-label="Exemple d'alertes dans le district de l'Ouest lausannois">
            <div class="demo-header">
              <span class="demo-title">Alertes · Ouest lausannois</span>
              <span class="demo-radius">1 km</span>
            </div>
            <div class="demo-item demo-item--red">
              <div class="demo-dot demo-dot--red"></div>
              <div class="demo-content">
                <strong>Cave d'immeuble forcée</strong>
                <span>Renens · il y a 30 min</span>
              </div>
              <a href="/alertes" class="demo-cta">Intervenir</a>
            </div>
            <div class="demo-item demo-item--orange">
              <div class="demo-dot demo-dot--orange"></div>
              <div class="demo-content">
                <strong>Véhicule fracturé au parking</strong>
                <span>Crissier · il y a 2h</span>
              </div>
            </div>
            <div class="demo-item demo-item--yellow">
              <div class="demo-dot demo-dot--yellow"></div>
              <div class="demo-content">
                <strong>Rôdeur signalé près des écoles</strong>
                <span>Prilly · aujourd'hui</span>
              </div>
            </div>
            <div class="demo-item">
              <div class="demo-dot demo-dot--blue"></div>
              <div class="demo-content">
                <strong>Alerte météo sur le canton</strong>
                <span>Vaud · il y a 1h</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO LOCALE -->
  <section class="section intro-section">
    <div class="container">
      <div class="intro-prose">
        <p>L'Ouest lausannois est le district le plus dense et le plus urbain du canton après Lausanne : Renens, Prilly, Ecublens, Bussigny, Crissier et Chavannes forment une agglomération continue, avec ses immeubles, ses zones commerciales, ses campus et ses axes de transport. Huit communes, une ville de fait.</p>
      </div>
    </div>
  </section>

  <!-- CHIFFRES / TABLEAU -->
  <section class="section figures-section" id="chiffres">
    <div class="container">
      <SectionHeader
        eyebrow="Les chiffres 2025"
        title="Ce que disent vraiment <em>les statistiques du district</em>"
        subtitle="La police cantonale vaudoise publie chaque année le détail des infractions, district par district et commune par commune. Voici le millésime 2025 pour le district de l'Ouest lausannois."
      />
      <div class="figures">
        {chiffres.map(c => (
          <div class="figure">
            <span class="figure-num">{c.num}</span>
            <span class="figure-label">{c.label}</span>
          </div>
        ))}
      </div>
      <div class="tbl-wrap">
        <table class="villages-table">
          <thead>
            <tr>
              <th scope="col">Commune</th>
              <th scope="col">Effractions</th>
              <th scope="col">Introductions</th>
              <th scope="col" class="col-patrim">Patrimoine</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Renens</td>
              <td>215</td>
              <td>46</td>
              <td class="col-patrim">1496</td>
            </tr>
            <tr>
              <td>Crissier</td>
              <td>126</td>
              <td>11</td>
              <td class="col-patrim">673</td>
            </tr>
            <tr>
              <td>Chavannes-près-Renens</td>
              <td>86</td>
              <td>17</td>
              <td class="col-patrim">526</td>
            </tr>
            <tr>
              <td>Bussigny</td>
              <td>76</td>
              <td>9</td>
              <td class="col-patrim">506</td>
            </tr>
            <tr>
              <td>Prilly</td>
              <td>76</td>
              <td>18</td>
              <td class="col-patrim">814</td>
            </tr>
            <tr>
              <td>Ecublens</td>
              <td>60</td>
              <td>21</td>
              <td class="col-patrim">633</td>
            </tr>
            <tr>
              <td>Saint-Sulpice</td>
              <td>32</td>
              <td>2</td>
              <td class="col-patrim">179</td>
            </tr>
            <tr>
              <td>Villars-Sainte-Croix</td>
              <td>4</td>
              <td>0</td>
              <td class="col-patrim">22</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="table-note">Principales communes du district de l'Ouest lausannois (les plus concernées en 2025). Le district compte 8 communes au total, toutes couvertes par Edgward.</p>
      <div class="figures-text">
        <p>En 2025, le district enregistre 675 cambriolages par effraction, en hausse marquée (+16,2% sur un an). C'est le niveau le plus élevé du canton hors Lausanne, à la mesure de sa densité.</p>
        <p><strong>Renens concentre à elle seule plus de 200 effractions</strong>, suivie de Crissier, Prilly et Bussigny. Dans un tissu aussi dense d'immeubles, l'essentiel se joue dans les parties communes, caves, parkings souterrains, entrées, et autour des gares et zones commerciales.</p>
        <p>La hausse cantonale de 2025 est particulièrement sensible dans l'Ouest lausannois. L'enjeu : savoir ce qui se passe dans son immeuble et son quartier, et pouvoir réagir vite. Edgward permet de suivre les alertes de son secteur et de faire intervenir une patrouille.</p>
      </div>
      <p class="source-note">
        Source : Statistique policière de la criminalité 2025, Police cantonale vaudoise -
        <a href="https://www.vd.ch/djes/polcant/statistiques/2025" target="_blank" rel="noopener">vd.ch</a>.
      </p>
    </div>
  </section>

  <!-- QUE FAIRE DE CETTE INFORMATION ? (double CTA deux vitesses) -->
  <LocalNextStep commune="le district de l'Ouest lausannois" titleLead="Dans le district de l'Ouest lausannois" addressPlace="" showDelay={false} />

  <!-- COUVERTURE -->
  <section class="section coverage-section" id="communes">
    <div class="container">
      <SectionHeader
        eyebrow="Couverture"
        title="Présents dans <em>tout le district</em>"
        subtitle="Chaque commune du district est couverte grâce à un réseau de sociétés de sécurité partenaires vaudoises."
      />
      <ul class="communes" aria-label="Communes couvertes dans le district de l'Ouest lausannois">
        <li>Renens</li>
        <li>Crissier</li>
        <li>Chavannes-près-Renens</li>
        <li>Bussigny</li>
        <li>Prilly</li>
        <li>Ecublens</li>
        <li>Saint-Sulpice</li>
        <li>Villars-Sainte-Croix</li>
        <li class="communes-more">…et toutes les autres communes du district</li>
      </ul>
    </div>
  </section>

  <!-- CONFIANCE -->
  <section class="section trust-section" id="confiance">
    <div class="container">
      <SectionHeader
        eyebrow="Ils nous font confiance"
        title="Des Vaudois·es <em>déjà protégé·es</em>"
      />
      <Testimonials items={temoignages} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <SectionHeader
        eyebrow="Questions fréquentes"
        title="La sécurité dans le district, <em>vos questions</em>"
      />
      <div class="faq-wrap">
        <FAQAccordion items={faq} />
      </div>
    </div>
  </section>

  <PartnersGrid
    title="Nos sociétés de sécurité partenaires dans le canton de Vaud"
    partners={partenairesVD}
  />

  <!-- FINAL CTA -->
  <FinalCTA
    title="Reprenez le contrôle de <em>votre sécurité</em>"
    description="Téléchargez l'application, activez gratuitement les alertes de votre secteur, et gardez la possibilité de faire intervenir une patrouille à la demande."
    appStoreUrl="https://apps.apple.com/ch/app/edgward/id6503622410"
    playStoreUrl="https://play.google.com/store/apps/details?id=ch.edgward.app.clients"
  />
</Base>

<style>
  .hero { background: var(--navy); color: white; padding: 72px 0 56px; overflow: hidden; position: relative; }
  .hero::before { content: ''; position: absolute; top: -300px; right: -200px; width: 700px; height: 700px; background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%); pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 2; }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: var(--brand-soft); color: var(--brand-light); padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 600; border: 1px solid rgba(70,120,220,0.3); margin-bottom: 22px; }
  .canton-flag { border-radius: 3px; box-shadow: 0 0 0 1px rgba(255,255,255,0.3); flex-shrink: 0; display: block; object-fit: cover; }
  .hero h1 { font-size: clamp(30px, 3.9vw, 48px); font-weight: 800; line-height: 1.05; letter-spacing: -0.025em; margin-bottom: 20px; color: white; }
  .hero h1 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .hero-content > p { font-size: 17px; line-height: 1.6; color: #cbd5e1; margin-bottom: 30px; max-width: 520px; }
  .hero-content > p strong { color: white; font-weight: 700; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-note { margin-top: 20px; font-size: 14px; line-height: 1.55; color: #cbd5e1; max-width: 480px; }
  .hero-note svg { color: var(--brand-light); vertical-align: -2px; margin-right: 6px; }
  .hero-note a { color: var(--brand-light); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .hero-note a:hover { color: white; }

  /* NEWSFEED DEMO */
  .hero-visual { display: flex; align-items: center; justify-content: center; min-height: 380px; }
  .newsfeed-demo { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); padding: 20px; width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 10px; }
  .demo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .demo-title { font-size: 13px; font-weight: 600; color: white; }
  .demo-radius { font-size: 11px; color: var(--brand-light); background: var(--brand-soft); padding: 2px 8px; border-radius: 100px; font-weight: 600; border: 1px solid rgba(70,120,220,0.3); }
  .demo-item { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.04); border-radius: 8px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.06); }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .demo-dot--red { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,0.6); }
  .demo-dot--orange { background: #f97316; box-shadow: 0 0 6px rgba(249,115,22,0.6); }
  .demo-dot--yellow { background: #eab308; }
  .demo-dot--blue { background: var(--brand-light); box-shadow: 0 0 6px rgba(70,120,220,0.6); }
  .demo-content { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .demo-content strong { font-size: 12px; color: white; font-weight: 600; }
  .demo-content span { font-size: 10px; color: #94a3b8; }
  .demo-cta { background: var(--brand); color: white; border: none; border-radius: 6px; font-size: 11px; font-weight: 600; padding: 4px 10px; cursor: pointer; font-family: inherit; white-space: nowrap; transition: background 0.2s ease; text-decoration: none; display: inline-block; }
  .demo-cta:hover { background: var(--brand-dark); }

  .intro-section { background: white; padding-bottom: 0; }
  .intro-prose { max-width: 760px; margin: 0 auto; }
  .intro-prose p { font-size: 17px; line-height: 1.7; color: var(--text); }
  .intro-prose strong { color: var(--navy); }

  /* CHIFFRES */
  .figures-section { background: white; }
  .figures { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 36px; }
  .figure { background: var(--soft); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 20px; text-align: center; }
  .figure-num { display: block; font-size: 34px; font-weight: 800; color: var(--navy); letter-spacing: -0.02em; margin-bottom: 6px; }
  .figure-label { display: block; font-size: 13px; color: var(--text-muted); line-height: 1.4; }

  .tbl-wrap { max-width: 820px; margin: 0 auto; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow-x: auto; }
  .villages-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .villages-table thead th { background: var(--navy); color: white; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; text-align: right; padding: 13px 18px; white-space: nowrap; }
  .villages-table thead th:first-child { text-align: left; }
  .villages-table tbody td { padding: 12px 18px; font-size: 15px; text-align: right; border-top: 1px solid var(--border); color: var(--text-muted); }
  .villages-table tbody td:first-child { text-align: left; font-weight: 600; color: var(--navy); }
  .villages-table tbody tr:nth-child(even) { background: var(--soft); }
  .table-note { max-width: 820px; margin: 14px auto 0; font-size: 13px; color: var(--text-muted); text-align: center; font-style: italic; }

  .figures-text { max-width: 760px; margin: 36px auto 0; }
  .figures-text p { font-size: 16px; line-height: 1.7; color: var(--text-muted); margin-bottom: 16px; }
  .figures-text p:last-child { margin-bottom: 0; }
  .figures-text strong { color: var(--navy); }
  .source-note { text-align: center; font-size: 13px; color: var(--text-muted); margin-top: 28px; }
  .source-note a { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }

  .solution-section { background: var(--soft); }
  .coverage-section { background: white; }
  .trust-section { background: var(--soft); }

  /* COVERAGE */
  .communes { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .communes li { background: var(--soft); border: 1px solid var(--border); border-radius: 100px; padding: 7px 16px; font-size: 13px; font-weight: 600; color: var(--navy); }
  .communes-more { background: transparent !important; border: none !important; color: var(--text-muted) !important; font-weight: 400 !important; font-style: italic; }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-visual { order: -1; }
    .figures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { padding: 48px 0 40px; }
    .figures { grid-template-columns: 1fr; }
    .villages-table .col-patrim { display: none; }
  }
  .faq-section { background: var(--soft); }
  .faq-wrap { max-width: 760px; margin: 0 auto; }
</style>
