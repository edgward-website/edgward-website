---
import Base from '../layouts/Base.astro';
import CoverageMap from '../components/CoverageMap.astro';
import PartnersGrid from '../components/PartnersGrid.astro';
import FinalCTA from '../components/FinalCTA.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageHero from '../components/PageHero.astro';
import { partners } from '../data/partners';
import { pagesCantons, pagesCommunesGE, pagesVillesVD, pagesCommunesNE } from '../data/localPages';

const cantonHref = Object.fromEntries(pagesCantons.map(c => [c.name, c.href]));
const sortFr = (arr) => [...arr].sort((a, b) => a.name.localeCompare(b.name, 'fr'));
const groupesLocaux = [
  { canton: 'Genève', href: cantonHref['Genève'], sousTitre: 'communes et régions', pages: sortFr(pagesCommunesGE) },
  { canton: 'Vaud', href: cantonHref['Vaud'], sousTitre: 'villes et districts', pages: sortFr(pagesVillesVD) },
  { canton: 'Neuchâtel', href: cantonHref['Neuchâtel'], sousTitre: 'communes', pages: sortFr(pagesCommunesNE) },
];

const deploymentCards = [
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    title: 'Qualité avant quantité',
    description: 'Chaque partenaire sécurité est sélectionné selon des critères stricts : certifications, équipement, délai d\'intervention, et évaluations terrain. Nous préférons moins de cantons mais un service irréprochable.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
    title: 'Couverture réelle',
    description: 'Un canton est déclaré "couvert" uniquement lorsque l’ensemble des communes sont couvertes par au moins un partenaire de sécurité. Pas de couverture partielle affichée comme complète.',
  },
  {
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>',
    title: 'Croissance maîtrisée',
    description: 'L\'extension géographique suit la disponibilité de partenaires qualifiés et la demande locale. Fribourg et le Valais sont en cours de déploiement ; le Jura est la prochaine priorité.',
  },
];

---

<Base
  title="Edgward en Suisse - Couverture territoriale | Edgward"
  description="Découvrez la couverture territoriale d'Edgward en Suisse romande. Genève, Vaud et Neuchâtel complètement couverts. Fribourg et Valais en déploiement."
>
  <PageHero
    eyebrow="Couverture territoriale"
    title="Edgward dans toute la <em>Suisse romande</em>"
    subtitle="Service d'intervention sécuritaire à la demande, déployé progressivement à travers les cantons romands. Genève, Vaud et Neuchâtel sont pleinement couverts."
  />

  <!-- CARTE INTERACTIVE -->
  <section class="map-section">
    <div class="container">
      <CoverageMap />
    </div>
  </section>

  <!-- PAGES LOCALES -->
  <section class="section local-section">
    <div class="container">
      <SectionHeader
        eyebrow="Près de chez vous"
        title="La sécurité <em>dans votre région</em>"
        subtitle="Alertes géolocalisées vérifiées et intervention à la demande, canton par canton et ville par ville."
        align="center"
      />
      <div class="local-accordions">
        {groupesLocaux.map((g, i) => (
          <details class="canton-acc" open={i === 0}>
            <summary>
              <span class="acc-title">Canton de {g.canton}</span>
              <span class="acc-cta acc-cta--closed">Voir les {g.sousTitre}</span>
              <span class="acc-cta acc-cta--open">Masquer</span>
              <svg class="acc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="acc-body">
              <a class="acc-pilier" href={g.href}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Tout le canton de {g.canton}
              </a>
              <ul class="local-links">
                {g.pages.map(p => <li><a href={p.href}>{p.name}</a></li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI CETTE PROGRESSION -->
  <section class="section why-section">
    <div class="container">
      <SectionHeader
        eyebrow="Notre approche"
        title="Pourquoi cette <em>progression</em> ?"
        subtitle="Edgward déploie son réseau de façon méthodique pour garantir un service fiable à chaque étape."
        align="center"
      />
      <div class="why-grid">
        {deploymentCards.map(card => (
          <div class="why-card">
            <div class="why-icon" set:html={card.icon} />
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TODO: valider liste et zones des partenaires avec l'équipe -->
  <!-- PARTENAIRES PAR ZONE -->
  <PartnersGrid
    title="Nos partenaires sécurité agréés"
    partners={partners}
  />

  <!-- VOTRE CANTON N'EST PAS COUVERT -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <span class="eyebrow-tag">Vous n'êtes pas encore couvert ?</span>
          <h2>Faites-le nous savoir</h2>
          <p>Chaque demande compte pour prioriser le déploiement. Si votre canton n'est pas encore couvert, signalez-nous votre intérêt - cela accélère concrètement notre expansion dans votre région.</p>
          <ul class="cta-benefits">
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Nous vous prévenons dès que votre région est couverte
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Votre demande accélère le déploiement
            </li>
            <li>
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Aucun engagement de votre côté
            </li>
          </ul>
        </div>
        <div class="cta-form">
          <ContactForm defaultSubject="Demande de couverture" />
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    title="Disponible maintenant dans <em>votre région</em>"
    description="Téléchargez l'app et vérifiez si votre adresse est couverte en quelques secondes."
  />
</Base>

<style>
  /* MAP */
  .map-section { background: var(--soft); padding: 56px 0; }

  /* PAGES LOCALES */
  .local-section { background: white; }
  .local-accordions { display: flex; flex-direction: column; gap: 12px; margin-top: 40px; max-width: 820px; margin-left: auto; margin-right: auto; }
  .canton-acc { border: 1px solid var(--border); border-radius: var(--radius-lg); background: white; overflow: hidden; }
  .canton-acc summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 12px; padding: 18px 22px; }
  .canton-acc summary::-webkit-details-marker { display: none; }
  .acc-title { font-size: 17px; font-weight: 700; color: var(--navy); }
  .acc-cta { margin-left: auto; font-size: 13px; font-weight: 600; color: var(--brand); }
  .acc-cta--open { display: none; }
  .canton-acc[open] .acc-cta--closed { display: none; }
  .canton-acc[open] .acc-cta--open { display: inline; }
  .canton-acc summary:hover .acc-cta { text-decoration: underline; }
  .acc-chevron { color: var(--text-muted); flex-shrink: 0; transition: transform 0.2s ease; }
  .canton-acc[open] .acc-chevron { transform: rotate(180deg); }
  .canton-acc[open] summary { border-bottom: 1px solid var(--border); }
  .canton-acc summary:hover .acc-title { color: var(--brand); }
  .acc-body { padding: 20px 22px 22px; }
  .acc-pilier { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 700; color: var(--brand); text-decoration: none; margin-bottom: 12px; }
  .acc-pilier:hover { text-decoration: underline; }
  .local-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .local-links a {
    display: inline-block; background: var(--soft); border: 1px solid rgba(70,120,220,0.35);
    border-radius: 100px; padding: 8px 18px; font-size: 14px; font-weight: 600;
    color: var(--brand); text-decoration: none; transition: all 0.15s ease;
  }
  .local-links a:hover { background: var(--brand-soft); border-color: var(--brand); }

  /* WHY */
  .why-section { background: white; }
  .why-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 24px; margin-top: 40px;
  }
  .why-card {
    background: var(--soft); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 28px;
  }
  .why-icon {
    width: 44px; height: 44px; color: var(--brand);
    margin-bottom: 16px;
  }
  .why-icon :global(svg) { width: 100%; height: 100%; }
  .why-card h3 { font-size: 18px; font-weight: 700; color: var(--navy); margin-bottom: 10px; }
  .why-card p { font-size: 14px; color: var(--text-muted); line-height: 1.6; }

  /* CTA SECTION */
  .cta-section { background: var(--soft); }
  .cta-inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 64px; align-items: start;
  }
  .eyebrow-tag {
    display: inline-block; font-size: 11px; font-weight: 700;
    color: var(--brand); text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--brand-soft); padding: 4px 12px; border-radius: 100px;
    margin-bottom: 16px;
  }
  .cta-text h2 {
    font-size: clamp(26px, 2.5vw, 36px); font-weight: 800; color: var(--navy);
    letter-spacing: -0.025em; margin-bottom: 16px; line-height: 1.15;
  }
  .cta-text p { font-size: 16px; color: var(--text-muted); line-height: 1.7; margin-bottom: 24px; }
  .cta-benefits { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .cta-benefits li {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; color: var(--text); font-weight: 500;
  }
  .cta-benefits li svg { color: #10b981; flex-shrink: 0; }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr; }
    .cta-inner { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
