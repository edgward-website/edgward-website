---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Testimonials from '../components/Testimonials.astro';
import PartnersGrid from '../components/PartnersGrid.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Steps from '../components/Steps.astro';
import { partners } from '../data/partners';

// --- Données propres à la commune ---
const commune = 'Chancy';
const quartiers = [
  'Le village', 'Passeiry', 'Fin-de-Chancy', 'La campagne frontalière',
];

const geneveNames = ['GPA SA', 'Python Sécurité SA', 'KRK Security', 'Global Sécurité (SPS)'];
const partenairesGE = partners.filter(p => geneveNames.includes(p.name));

// Chiffres officiels 2025 - Statistique policière de la criminalité par commune, Corps de police GE (ge.ch).
const chiffres = [
  { num: '6', label: 'cambriolages par effraction' },
  { num: '3', label: 'introductions clandestines' },
  { num: '16', label: 'vols' },
  { num: '56', label: 'infractions contre le patrimoine' },
];

const etapes = [
  { num: '1', title: "Téléchargez l'application", description: "Edgward est disponible sur l'App Store et Google Play. La création de votre compte prend deux minutes." },
  { num: '2', title: 'Activez les alertes', description: "Renseignez votre adresse et suivez les signalements vérifiés de votre région. Cette partie est 100% gratuite." },
  { num: '3', title: 'Déclenchez une intervention', description: "En cas de doute, commandez une patrouille depuis l'app et recevez un rapport une fois l'intervention réalisée." },
];

const temoignages = [
  {
    quote: "Habitante seule, j'avais besoin d'une solution simple et rassurante. Fonctionnel et avantageux niveau prix.",
    name: 'Sonia F.',
    role: 'Cliente à Soral',
    initials: 'SF',
  },
  {
    quote: "Je n'étais pas sûr de qui traînait dans mon jardin, les agents ont été bien réactifs, top.",
    name: 'Marc M.',
    role: 'Client à Genève',
    initials: 'MM',
  },
  {
    quote: "Intervention rapide et agent très sympa, merci !",
    name: 'Emmanuelle F.',
    role: 'Cliente à Genève',
    initials: 'EF',
  },
];

const faq = [
  {
    "question": "Edgward est-il disponible à Chancy ?",
    "answer": "Oui. Chancy est une commune genevoise partenaire d'Edgward : le service couvre tout le village grâce aux sociétés de sécurité partenaires du canton. Vous recevez les alertes vérifiées près de chez vous et pouvez faire intervenir une patrouille à la demande, avec un délai moyen de 10 à 15 minutes."
  },
  {
    "question": "Quel est l'avantage pour les habitants de Chancy ?",
    "answer": "Grâce au partenariat avec la commune, les habitants de Chancy bénéficient d'un tarif préférentiel : l'abonnement pour la première année ne coûte que CHF 97.50, soit à peine plus de CHF 8.- par mois. Faites votre demande sur notre page dédiée aux habitants de Chancy - nous validons votre éligibilité avec la commune, puis vous activez votre accès."
  },
  {
    "question": "Chancy est-elle très ciblée ?",
    "answer": "Non : avec 6 cambriolages par effraction en 2025, Chancy est l'une des communes les plus épargnées du canton. Le vrai enjeu d'un village frontalier n'est pas le nombre de faits, mais l'éloignement : quand quelque chose survient, une villa isolée peut rester longtemps sans que personne ne réagisse. C'est cette vulnérabilité qu'Edgward aide à combler."
  },
  {
    "question": "Combien coûte Edgward et comment l'activer à Chancy ?",
    "answer": "Les alertes et informations de sécurité sont 100% gratuites. L'abonnement complet est à CHF 15.-/mois, et vous ne payez une intervention que si vous en commandez une. Habitant de Chancy, vous bénéficiez d'un tarif préférentiel la première année : rendez-vous sur notre page habitants pour faire votre demande, puis téléchargez l'application et activez vos alertes."
  }
];
---

<Base
  title="Sécurité à Chancy : commune partenaire d'Edgward | Edgward"
  description="Chancy, commune genevoise partenaire d'Edgward. Chiffres officiels 2025, tarif préférentiel réservé aux habitants, alertes vérifiées et intervention en 10-15 min."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <img class="canton-flag" src="/assets/flag-geneve.png" width="22" height="22" alt="" aria-hidden="true">
            Chancy · Canton de Genève
          </div>
          <h1>Votre sécurité à Chancy,<br><em>commune partenaire</em></h1>
          <p>Chancy s'associe à Edgward pour la sécurité de ses habitants. Suivez ce qui se passe réellement dans le village <strong>et</strong> faites intervenir une patrouille à la demande. Alertes vérifiées et gratuites, intervention en 10 à 15 minutes - et un <strong>tarif préférentiel</strong> réservé aux habitants.</p>
          <div class="hero-ctas">
            <a href="/chancy" class="btn-primary">
              Voir l'offre habitants
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/securite-geneve" class="btn-secondary">
              Voir tout le canton de Genève
            </a>
          </div>
          <p class="hero-note">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Vous êtes une commune ? Découvrez le <a href="/communes">modèle pour les communes</a>. Vous avez une alarme ? Voyez l’<a href="/intervention-alarme">intervention sur alarme</a>.
          </p>
        </div>
        <div class="hero-visual">
          <div class="newsfeed-demo" aria-label="Exemple d'alertes à Chancy">
            <div class="demo-header">
              <span class="demo-title">Alertes · {commune}</span>
              <span class="demo-radius">1 km</span>
            </div>
            <div class="demo-item demo-item--red">
              <div class="demo-dot demo-dot--red"></div>
              <div class="demo-content">
                <strong>Véhicule inconnu vers la douane</strong>
                <span>Le village · il y a 45 min</span>
              </div>
              <a href="/chancy" class="demo-cta">Intervenir</a>
            </div>
            <div class="demo-item demo-item--orange">
              <div class="demo-dot demo-dot--orange"></div>
              <div class="demo-content">
                <strong>Rôdeur signalé en soirée</strong>
                <span>La campagne · il y a 3h</span>
              </div>
            </div>
            <div class="demo-item demo-item--yellow">
              <div class="demo-dot demo-dot--yellow"></div>
              <div class="demo-content">
                <strong>Démarchage à domicile suspect</strong>
                <span>Passeiry · aujourd'hui</span>
              </div>
            </div>
            <div class="demo-item">
              <div class="demo-dot demo-dot--blue"></div>
              <div class="demo-content">
                <strong>Alerte météo sur le canton</strong>
                <span>Genève · il y a 1h</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO LOCALE -->
  <section class="section intro-section">
    <div class="container">
      <div class="intro-prose">
        <p><strong>Chancy est la commune la plus à l'ouest de Suisse</strong> - un village d'environ 1'700 habitants posé au bord du Rhône, contre la frontière française, à l'extrême sud-ouest du canton. Comme souvent en zone rurale et frontalière, l'enjeu de sécurité n'est pas tant le nombre de faits que l'éloignement : quand quelque chose survient, une villa isolée peut rester longtemps sans que personne ne réagisse. C'est pour renforcer la tranquillité de ses habitants que Chancy est devenue commune partenaire d'Edgward.</p>
      </div>
    </div>
  </section>

  <!-- CALLOUT PARTENARIAT -->
  <section class="section partner-section">
    <div class="container">
      <div class="partner-card fade-in">
        <img src="/assets/ed-pose.png" alt="" class="partner-ed" width="90" height="90" aria-hidden="true" loading="lazy">
        <div class="partner-text">
          <span class="partner-badge">★ Commune partenaire · Chancy, GE</span>
          <h4>Un tarif réservé aux habitants de Chancy</h4>
          <p>Chancy fait bénéficier ses habitants d'un tarif préférentiel sur l'abonnement Edgward. Faites votre demande en ligne : nous validons votre éligibilité avec la commune, puis vous activez votre accès.</p>
        </div>
        <a href="/chancy" class="partner-cta">Voir l'offre habitants →</a>
      </div>
    </div>
  </section>

  <!-- CHIFFRES COMMUNAUX -->
  <section class="section figures-section" id="chiffres">
    <div class="container">
      <SectionHeader
        eyebrow="Les chiffres 2025"
        title="Ce que disent vraiment <em>les statistiques à Chancy</em>"
        subtitle="La police cantonale genevoise publie chaque année le détail des infractions commune par commune. Voici le millésime 2025 pour Chancy."
      />
      <div class="figures">
        {chiffres.map(c => (
          <div class="figure">
            <span class="figure-num">{c.num}</span>
            <span class="figure-label">{c.label}</span>
          </div>
        ))}
      </div>
      <div class="figures-text">
        <p>Soit <strong>9 cambriolages en une année</strong>, tous modes confondus (6 par effraction, 3 introductions clandestines). En valeur absolue, Chancy est l'une des communes les plus épargnées du canton - et c'est une bonne nouvelle, qu'il faut dire clairement.</p>
        <p><strong>Mais le vrai enjeu d'un village frontalier n'est pas le nombre : c'est l'éloignement.</strong> Quand un fait survient - un rôdeur, un véhicule inconnu qui repart vers la douane - les secours sont loin, et une villa isolée peut rester longtemps sans que personne ne s'en aperçoive. C'est cette vulnérabilité, plus que les statistiques, qui a motivé le choix de la commune.</p>
        <p>À l'échelle du canton, la criminalité recule de 4% en 2025. À Chancy, Edgward répond à un besoin très concret : savoir vite ce qui se passe dans le village, et pouvoir faire venir une patrouille sans dépendre uniquement des délais d'intervention en zone rurale.</p>
      </div>
      <p class="source-note">
        Source : Statistique policière de la criminalité 2025 par commune, Corps de police du canton de Genève -
        <a href="https://www.ge.ch/document/statistique-policiere-criminalite-2025-commune" target="_blank" rel="noopener">ge.ch</a>.
      </p>
    </div>
  </section>

  <!-- COMMENT CA MARCHE -->
  <section class="section how-section" id="comment-ca-marche">
    <div class="container">
      <SectionHeader
        eyebrow="L'application"
        title="Comment ça marche, <em>concrètement</em>"
        subtitle="Trois étapes, depuis votre téléphone. Les alertes et informations de sécurité sont gratuites ; vous ne payez que si vous déclenchez une intervention."
      />
      <Steps steps={etapes} />
      <div class="how-ctas">
        <a href="/chancy" class="btn-primary">
          Voir l'offre réservée aux habitants
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/activer-les-alertes" class="btn-secondary">Activer les alertes - 100% gratuit</a>
      </div>
    </div>
  </section>

  <!-- QUARTIERS -->
  <section class="section coverage-section" id="quartiers">
    <div class="container">
      <SectionHeader
        eyebrow="Couverture"
        title="Présents dans <em>tout Chancy</em>"
        subtitle="Du cœur du village aux fermes isolées de la campagne frontalière, Edgward couvre l'ensemble de la commune grâce à un réseau de sociétés de sécurité genevoises."
      />
      <ul class="communes" aria-label="Secteurs couverts à Chancy">
        {quartiers.map(q => <li>{q}</li>)}
        <li class="communes-more">…et l'ensemble du territoire communal</li>
      </ul>
    </div>
  </section>

  <!-- CONFIANCE -->
  <section class="section trust-section" id="confiance">
    <div class="container">
      <SectionHeader
        eyebrow="Ils nous font confiance"
        title="Des Genevois·es <em>déjà protégé·es</em>"
      />
      <Testimonials items={temoignages} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <SectionHeader
        eyebrow="Questions fréquentes"
        title="La sécurité à Chancy, <em>vos questions</em>"
      />
      <div class="faq-wrap">
        <FAQAccordion items={faq} />
      </div>
    </div>
  </section>

  <PartnersGrid
    title="Nos sociétés de sécurité partenaires à Genève"
    partners={partenairesGE}
  />

  <!-- FINAL CTA -->
  <FinalCTA
    title="Reprenez le contrôle de <em>votre sécurité à Chancy</em>"
    description="Habitant de Chancy, profitez du tarif préférentiel négocié par votre commune : faites votre demande, activez gratuitement les alertes de votre secteur, et gardez la possibilité de faire intervenir une patrouille en 10 à 15 minutes."
    appStoreUrl="https://apps.apple.com/ch/app/edgward/id6503622410"
    playStoreUrl="https://play.google.com/store/apps/details?id=ch.edgward.app.clients"
  />
</Base>

<style>
  .hero { background: var(--navy); color: white; padding: 72px 0 56px; overflow: hidden; position: relative; }
  .hero::before { content: ''; position: absolute; top: -300px; right: -200px; width: 700px; height: 700px; background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%); pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 2; }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: var(--brand-soft); color: var(--brand-light); padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 600; border: 1px solid rgba(70,120,220,0.3); margin-bottom: 22px; }
  .canton-flag { border-radius: 3px; box-shadow: 0 0 0 1px rgba(255,255,255,0.3); flex-shrink: 0; display: block; object-fit: cover; }
  .hero h1 { font-size: clamp(32px, 4.1vw, 50px); font-weight: 800; line-height: 1.05; letter-spacing: -0.025em; margin-bottom: 20px; color: white; }
  .hero h1 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .hero-content > p { font-size: 17px; line-height: 1.6; color: #cbd5e1; margin-bottom: 30px; max-width: 520px; }
  .hero-content > p strong { color: white; font-weight: 700; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-note { margin-top: 20px; font-size: 14px; line-height: 1.55; color: #cbd5e1; max-width: 480px; }
  .hero-note svg { color: var(--brand-light); vertical-align: -2px; margin-right: 6px; }
  .hero-note a { color: var(--brand-light); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .hero-note a:hover { color: white; }

  /* NEWSFEED DEMO */
  .hero-visual { display: flex; align-items: center; justify-content: center; min-height: 380px; }
  .newsfeed-demo { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); padding: 20px; width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 10px; }
  .demo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .demo-title { font-size: 13px; font-weight: 600; color: white; }
  .demo-radius { font-size: 11px; color: var(--brand-light); background: var(--brand-soft); padding: 2px 8px; border-radius: 100px; font-weight: 600; border: 1px solid rgba(70,120,220,0.3); }
  .demo-item { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.04); border-radius: 8px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.06); }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .demo-dot--red { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,0.6); }
  .demo-dot--orange { background: #f97316; box-shadow: 0 0 6px rgba(249,115,22,0.6); }
  .demo-dot--yellow { background: #eab308; }
  .demo-dot--blue { background: var(--brand-light); box-shadow: 0 0 6px rgba(70,120,220,0.6); }
  .demo-content { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .demo-content strong { font-size: 12px; color: white; font-weight: 600; }
  .demo-content span { font-size: 10px; color: #94a3b8; }
  .demo-cta { background: var(--brand); color: white; border: none; border-radius: 6px; font-size: 11px; font-weight: 600; padding: 4px 10px; cursor: pointer; font-family: inherit; white-space: nowrap; transition: background 0.2s ease; text-decoration: none; display: inline-block; }
  .demo-cta:hover { background: var(--brand-dark); }

  .intro-section { background: white; padding-bottom: 0; }
  .intro-prose { max-width: 760px; margin: 0 auto; }
  .intro-prose p { font-size: 17px; line-height: 1.7; color: var(--text); }
  .intro-prose strong { color: var(--navy); }

  /* CALLOUT PARTENARIAT */
  .partner-section { background: white; padding-top: 40px; padding-bottom: 40px; }
  .partner-card {
    background: var(--navy); color: white; border-radius: var(--radius-lg); padding: 28px 36px;
    display: flex; align-items: center; gap: 24px; position: relative; overflow: hidden;
  }
  .partner-card::before {
    content: ''; position: absolute; top: -50%; right: -10%; width: 400px; height: 400px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%); pointer-events: none;
  }
  .partner-ed { width: 90px; flex-shrink: 0; position: relative; z-index: 1; }
  .partner-badge {
    background: var(--brand); color: white; padding: 4px 11px; border-radius: 100px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    display: inline-block; margin-bottom: 8px;
  }
  .partner-text { flex: 1; position: relative; z-index: 1; }
  .partner-text h4 { font-size: 22px; font-weight: 700; margin-bottom: 6px; letter-spacing: -0.015em; }
  .partner-text p { font-size: 14px; color: #cbd5e1; line-height: 1.5; }
  .partner-cta {
    background: transparent; color: white; border: 1px solid rgba(255,255,255,0.3);
    padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;
    white-space: nowrap; transition: all 0.2s ease; flex-shrink: 0; position: relative; z-index: 1;
  }
  .partner-cta:hover { background: white; color: var(--navy); }

  /* CHIFFRES */
  .figures-section { background: white; }
  .figures { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 36px; }
  .figure { background: var(--soft); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 20px; text-align: center; }
  .figure-num { display: block; font-size: 34px; font-weight: 800; color: var(--navy); letter-spacing: -0.02em; margin-bottom: 6px; }
  .figure-label { display: block; font-size: 13px; color: var(--text-muted); line-height: 1.4; }
  .figures-text { max-width: 760px; margin: 0 auto; }
  .figures-text p { font-size: 16px; line-height: 1.7; color: var(--text-muted); margin-bottom: 16px; }
  .figures-text p:last-child { margin-bottom: 0; }
  .figures-text strong { color: var(--navy); }
  .source-note { text-align: center; font-size: 13px; color: var(--text-muted); margin-top: 28px; }
  .source-note a { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }

  .how-section { background: white; }
  .how-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 40px; }
  .coverage-section { background: var(--soft); }
  .trust-section { background: white; }

  /* COVERAGE */
  .communes { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .communes li { background: white; border: 1px solid var(--border); border-radius: 100px; padding: 7px 16px; font-size: 13px; font-weight: 600; color: var(--navy); }
  .communes-more { background: transparent !important; border: none !important; color: var(--text-muted) !important; font-weight: 400 !important; font-style: italic; }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-visual { order: -1; }
    .figures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { padding: 48px 0 40px; }
    .figures { grid-template-columns: 1fr; }
    .partner-card { flex-direction: column; text-align: center; padding: 28px 24px; }
    .partner-ed { width: 72px; }
  }
  .faq-section { background: var(--soft); }
  .faq-wrap { max-width: 760px; margin: 0 auto; }
</style>
