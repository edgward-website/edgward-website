---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
---

<Base
  title="How it works - Edgward, on-demand security"
  description="Book a security intervention in 3 steps: subscribe, set up your locations, book in one tap. An agent at your door in under 20 minutes."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">How it works</span>
        <h1>From subscription<br>to <em>intervention in 3 steps</em></h1>
        <p>No hardware to install. No long-term commitment. A professional security agent at your door within minutes.</p>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section video-section">
    <div class="container">
      <SectionHeader
        eyebrow="Discover Edgward"
        title="See <em>how easy it is</em>"
        subtitle="A short video to understand the Edgward service in under a minute."
      />
      <div class="video-wrapper">
        <video class="video-frame" controls preload="metadata" playsinline>
          <source src="/assets/tuto-app.mp4" type="video/mp4">
          Your browser does not support video playback.
          <a href="/assets/tuto-app.mp4">Download the video</a>.
        </video>
      </div>
    </div>
  </section>

  <!-- STEPS DÉTAILLÉES -->
  <section class="section steps-section">
    <div class="container">
      <SectionHeader
        eyebrow="3 simple steps"
        title="Your security <em>in a few taps</em>"
      />
      <div class="steps-detailed">
        <div class="step-detail fade-in">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Download the app and subscribe</h3>
            <p>Create your account in a few steps and try Edgward free for one month - cancel at any time.</p>
            <ul class="step-checklist">
              <li>Quick sign-up with an email address or a Swiss number</li>
              <li>Secure payment by bank card</li>
              <li>No commitment, cancel in one tap</li>
            </ul>
          </div>
        </div>

        <div class="step-detail fade-in">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Set up the locations you want to protect</h3>
            <p>Register your home, your office or any other place you want to secure. Add specific instructions for agents: access code, floor, special notes.</p>
            <ul class="step-checklist">
              <li>Set up to 2 locations (private / professional)</li>
              <li>Specify access details</li>
              <li>Set emergency contacts</li>
            </ul>
          </div>
        </div>

        <div class="step-detail fade-in">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Book an intervention in one tap</h3>
            <p>When needed, open the app, request an intervention and select the firm of your choice according to your criteria (time or price).</p>
            <ul class="step-checklist">
              <li>Nearest patrols shown</li>
              <li>Real-time tracking of the intervention</li>
              <li>Intervention report sent after each assignment</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CE QUI SE PASSE ENSUITE -->
  <section class="section after-section">
    <div class="container">
      <SectionHeader
        eyebrow="During the intervention"
        title="What happens <em>after your request</em>"
      />
      <div class="after-grid">
        <div class="after-card fade-in">
          <div class="after-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg>
          </div>
          <h4>A choice of patrols</h4>
          <p>Choose one of the available patrols according to your criteria: firm, on-site arrival time or price.</p>
        </div>
        <div class="after-card fade-in">
          <div class="after-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h4>Real-time tracking</h4>
          <p>Follow the intervention steps from booking through to completion. The patrol will contact you if you wish.</p>
        </div>
        <div class="after-card fade-in">
          <div class="after-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h4>Intervention report</h4>
          <p>After each assignment, a detailed report is available in the app: arrival time, findings, actions taken and recommendations.</p>
        </div>
        <div class="after-card fade-in">
          <div class="after-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4>Certified agents</h4>
          <p>We work only with recognised security firms accredited by the cantonal authorities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container">
      <SectionHeader
        eyebrow="Frequently asked questions"
        title="Everything you need <em>to know</em>"
      />
      <div class="faq-container">
        <FAQAccordion items={[
          { question: "How much does an intervention cost?", answer: "Each partner firm sets the cost of its intervention freely, according to its own criteria (date, time and location of the intervention). The price includes travel and 60 minutes of intervention on site." },
          { question: "How quickly does the agent arrive?", answer: "In urban areas, the average response time is under 15 minutes. In suburban or rural areas, it can vary depending on the availability of agents in your area." },
          { question: "What types of intervention can I request?", answer: "Security patrol, escort, deterrent presence, site opening/closing, alarm verification… Edgward covers a broad range of private security assignments." },
          { question: "Do I need to install any equipment?", answer: "No. All you need is your smartphone and the app. No camera, sensor or alarm panel is required. You can use your own equipment that is already installed, or use your own tools for self-monitoring." },
          { question: "Can I cancel at any time?", answer: "Yes. There is no minimum commitment. You can cancel your subscription directly from the app, in one tap. Cancellation takes effect at the end of the period already paid for." },
          { question: "Are the agents genuinely professional?", answer: "Yes. The patrols shown come exclusively from duly licensed security firms." },
        ]} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-block fade-in">
        <h2>Ready to try <em>Edgward</em>?</h2>
        <p>Download the app and enjoy a one-month free trial. Cancel at any time.</p>
        <div class="cta-buttons">
          <a href="https://apps.apple.com/ch/app/edgward/id6503622410" class="btn-primary" target="_blank" rel="noopener noreferrer">
            Download on the App Store
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="https://play.google.com/store/apps/details?id=ch.edgward.app.clients" class="btn-secondary" target="_blank" rel="noopener noreferrer">
            Get it on Google Play
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--navy);
    color: white;
    padding: 80px 0 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -200px; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 12px; color: var(--brand-light);
    font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.025em; margin-bottom: 20px; color: white;
  }
  .hero h1 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .hero p { font-size: 17px; color: #cbd5e1; line-height: 1.6; max-width: 540px; margin: 0 auto; }

  /* VIDEO */
  .video-section { background: white; }
  .video-wrapper { max-width: 800px; margin: 0 auto; }
  .video-frame {
    display: block;
    margin: 0 auto;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 9 / 16;
    background: var(--navy);
    border-radius: var(--radius-lg);
    object-fit: contain;
  }

  /* STEPS DETAILED */
  .steps-section { background: var(--soft); }
  .steps-detailed { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 0; }
  .step-detail {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
  }
  .step-detail:last-child { border-bottom: none; }
  .step-number {
    width: 64px; height: 64px;
    background: var(--navy);
    color: var(--brand-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 400;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    flex-shrink: 0;
  }
  .step-content h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .step-content p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .step-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .step-checklist li {
    font-size: 13px;
    color: var(--text-muted);
    padding-left: 22px;
    position: relative;
    line-height: 1.5;
  }
  .step-checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--brand);
    font-weight: 700;
    font-size: 12px;
  }

  /* AFTER GRID */
  .after-section { background: white; }
  .after-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .after-card {
    background: var(--soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    transition: all 0.2s ease;
  }
  .after-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
  .after-icon {
    width: 48px; height: 48px;
    background: var(--navy);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--brand-light);
  }
  .after-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .after-card p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* FAQ */
  .faq-section { background: var(--soft); }
  .faq-container { max-width: 720px; margin: 0 auto; }

  /* CTA */
  .cta-section { background: white; }
  .cta-block {
    background: var(--navy);
    border-radius: var(--radius-lg);
    padding: 56px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-block::before {
    content: '';
    position: absolute;
    top: -50%; left: 50%;
    transform: translateX(-50%);
    width: 500px; height: 500px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .cta-block h2 {
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 800;
    color: white;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    position: relative;
    z-index: 1;
  }
  .cta-block h2 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .cta-block > p {
    font-size: 16px;
    color: #cbd5e1;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
  }
  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 1024px) {
    .after-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { padding: 56px 0 48px; }
    .step-detail { grid-template-columns: 48px 1fr; gap: 16px; }
    .step-number { width: 48px; height: 48px; font-size: 18px; }
    .after-grid { grid-template-columns: 1fr; }
    .cta-block { padding: 40px 24px; }
  }
</style>
