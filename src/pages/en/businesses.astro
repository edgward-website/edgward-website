---
import Base from '../../layouts/Base.astro';
import BenefitsGrid from '../../components/BenefitsGrid.astro';
import PricingCard from '../../components/PricingCard.astro';
import Testimonials from '../../components/Testimonials.astro';
import ContactForm from '../../components/ContactForm.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EdSonar from '../../components/EdSonar.astro';
import { localize } from '../../i18n/routes';

const L = (p: string) => localize(p, 'en');

const useCases = [
  {
    eyebrow: 'Retail',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>',
    title: 'Late closing, parcel delivered - agent needed',
    description: "Handle unexpected situations with no fixed cost: night-time check, alarm verification, reassuring presence.",
  },
  {
    eyebrow: 'Construction site',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 18h19"/><path d="M4 18v-1.5a8 8 0 0116 0V18"/><path d="M10 8.2V4.5a1 1 0 011-1h2a1 1 0 011 1v3.7"/><path d="M14 4.7a6.5 6.5 0 014 5.3M10 4.7a6.5 6.5 0 00-4 5.3"/></svg>',
    title: 'Night-time surveillance without a permanent guard',
    description: "Materials and equipment protected at night. Rapid intervention in the event of intrusion, with no fixed monthly cost.",
  },
  {
    eyebrow: 'Office / SME',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
    title: 'Flexible security for your premises',
    description: "Periodic patrols, post-alarm verification, secured reception at events. You choose, you activate.",
  },
];

const testimonials = [
  {
    quote: "Strangers in our garage in Belmont. Two agents responded. Better value than a conventional alarm connection.",
    name: 'Mike K.',
    role: 'Belmont VD - Garage manager',
    initials: 'MK',
    stars: 5,
  },
];

const priceRows = [
  { label: 'Subscription (annual basis)', value: 'CHF 12.50/month' },
  { label: 'Intervention (average price per intervention)', value: '~CHF 105 - 170' },
];
---

<Base
  title="Businesses - On-demand professional security | Edgward"
  description="Protect premises, construction sites and shops with Edgward. Multi-site, consolidated billing, intervention reporting. A flexible alternative to conventional remote monitoring."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <span class="hero-eyebrow">Businesses & Alarm receiving centres</span>
          <h1>Shops, premises and construction sites<br>protected <em>on demand</em></h1>
          <p>Stop the fixed costs of remote monitoring. With Edgward, you activate security when you need it, on the sites that require it.</p>
          <div class="hero-ctas">
            <a href="#contact" class="btn-primary">
              Request a quote
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href={L('/comment-ca-marche')} class="btn-secondary">Learn more</a>
          </div>
          <p class="hero-reassurance">No installation · No long-term commitment · From CHF 15/month per site</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <EdSonar />
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="section" id="usages">
    <div class="container">
      <SectionHeader
        eyebrow="Use cases"
        title="Three situations where Edgward <em>makes the difference </em>"
        subtitle="Shop, construction site, office - a single solution for all your security needs."
      />
      <BenefitsGrid benefits={useCases} cols={3} />
    </div>
  </section>

  <!-- PRICING -->
  <section class="section pricing-section" id="tarifs">
    <div class="container">
      <SectionHeader
        eyebrow="Pricing"
        title="A <em>reasonable</em> investment"
        subtitle="Subscription per site + only the interventions you actually trigger. No surprises."
      />
      <PricingCard
        headline="Pricing on request, based on volume"
        description="No CHF 2,000-6,000 installation as with conventional remote monitoring. No long-term commitment. You pay the platform subscription + the interventions you trigger."
        ctaLabel="Request a quote"
        ctaHref="#contact"
        priceRows={priceRows}
        highlight={{ label: 'Saving vs. remote monitoring', value: 'CHF 2,000-6,000' }}
      />
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section testimonials-section">
    <div class="container">
      <SectionHeader
        eyebrow="Testimonials"
        title="What our <em>professional clients</em> say"
      />
      <Testimonials items={testimonials} />
    </div>
  </section>

