              <div class="email-line"><strong>From:</strong> centrale@securite.ch</div>
              <div class="email-line"><strong>To:</strong> dispatch@edgward.ch</div>
              <div class="email-line email-subject"><strong>Subject:</strong> ALARM VERIFICATION - Alarm Zone A</div>
