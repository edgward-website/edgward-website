---
import Base from '../../layouts/Base.astro';
import PartnerDetailCard from '../../components/PartnerDetailCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { localize } from '../../i18n/routes';

const L = (p: string) => localize(p, 'en');

const partners = [
  {
    name: 'SPS - Global Sécurité',
    zone: 'Lake Geneva region',
    description: "A recognised name in manned security, Global Sécurité offers surveillance, access control and rapid intervention across the Lake Geneva region. Available 24/7.",
    siteUrl: 'https://global-securite.ch/',
    logo: '/assets/partners/global-securite.png',
  },
  {
    name: 'GPA SA',
    zone: 'French-speaking Switzerland',
    description: "A leading security firm in French-speaking Switzerland. Operating 24/7, it specialises in mobile patrols and rapid intervention across the whole region.",
    siteUrl: 'https://www.gpa.ch/',
    logo: '/assets/partners/gpa.png',
  },
  {
    name: 'Python Sécurité SA',
    zone: 'Geneva (20+ years\' experience)',
    description: "More than 20 years of expertise in Geneva. Python Sécurité provides tailored solutions: site surveillance, mobile intervention and access management for individuals and businesses.",
    siteUrl: 'https://python-securite.ch/',
    logo: '/assets/partners/python.png',
  },
  {
    name: 'Sécurice',
    zone: 'Neuchâtel',
    description: "A security specialist in the canton of Neuchâtel. Sécurice provides patrol rounds, 24/7 intervention and property protection for individuals and businesses.",
    siteUrl: 'https://www.securice.ch/',
    logo: '/assets/partners/securice.png',
  },
  {
    name: 'Juggers',
    zone: 'Vaud',
    description: "A security firm active in Geneva and Vaud. Juggers responds quickly for surveillance, guarding and event security assignments.",
    siteUrl: 'https://www.juggers.ch/',
    logo: '/assets/partners/juggers.png',
  },
  {
    name: 'Alpshawk',
    zone: 'Valais',
    description: "Based in the canton of Valais, Alpshawk provides tailored security services: patrol rounds, intervention and surveillance for individuals and professionals.",
    siteUrl: 'https://www.alpshawk.ch/',
    logo: '/assets/partners/alpshawk.png',
  },
  {
    name: 'Wolfguard',
    zone: 'Vaud',
    description: "A security specialist in the canton of Vaud, Wolfguard offers guarding, patrol rounds and rapid intervention to protect property and people.",
    siteUrl: 'https://www.wolfguard.ch/',
    logo: '/assets/partners/wolfguard.png',
  },
  {
    name: 'Roc Sécurité',
    zone: 'Valais',
    description: "A Valais-based private security firm. Roc Sécurité offers surveillance, intervention and protection services suited to the canton's needs.",
    siteUrl: 'https://www.rocsecurite.ch/',
    logo: '/assets/partners/roc-securite.png',
  },
  {
    name: 'KRK Security',
    zone: 'Geneva',
    description: "Active in Geneva, KRK Security provides guarding, patrols and intervention to secure shops, businesses and individuals.",
    siteUrl: 'https://krksecurity.ch/',
    logo: '/assets/partners/krk.png',
  },
];
---

<Base
  title="Security partners - Edgward network in French-speaking Switzerland"
  description="Discover Edgward's 9 partner security firms in French-speaking Switzerland. Licensed, accredited and available 24/7 across Geneva, Vaud and Valais."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">Partner network</span>
        <h1>Security firms <em>at your service</em></h1>
        <p>Edgward relies on a selected network of licensed security firms across French-speaking Switzerland. All are held to the same standards of quality and responsiveness.</p>
      </div>
    </div>
  </section>

  <!-- PARTNERS GRID -->
  <section class="section partners-section">
    <div class="container">
      <SectionHeader
        eyebrow="Our partners"
        title="Firms that are <em>selected and accredited</em>"
        subtitle="Every Edgward partner is audited on its qualifications, its response times and its customer satisfaction."
      />
      <div class="partners-grid">
        {partners.map(p => (
          <PartnerDetailCard
            name={p.name}
            zone={p.zone}
            description={p.description}
            siteUrl={p.siteUrl}
            logo={p.logo}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CRITERIA -->
  <section class="section criteria-section">
    <div class="container">
      <SectionHeader
        eyebrow="Selection criteria"
        title="How we select <em>our partners</em>"
      />
      <div class="criteria-grid">
        <div class="criterion fade-in">
          <div class="criterion-num">01</div>
          <h3>Cantonal licence</h3>
          <p>All partner firms are licensed by the relevant cantonal authorities and comply with the regulations governing private security agents.</p>
        </div>
        <div class="criterion fade-in">
          <div class="criterion-num">02</div>
          <h3>Response time</h3>
          <p>Each partner is assessed on its ability to respond to requests in under 20 minutes in urban areas. Actual times are shown in the app.</p>
        </div>
        <div class="criterion fade-in">
          <div class="criterion-num">03</div>
          <h3>Customer satisfaction</h3>
          <p>Every intervention is rated by the user. An insufficient score triggers an audit and may lead to the partner's suspension.</p>
        </div>
        <div class="criterion fade-in">
          <div class="criterion-num">04</div>
          <h3>Ongoing training</h3>
          <p>Agents must show evidence of up-to-date training, including first aid, conflict management and Edgward procedures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BECOME A PARTNER -->
  <section class="section become-section">
    <div class="container">
      <div class="become-block fade-in">
        <div class="become-content">
          <span class="become-eyebrow">Are you a security firm?</span>
          <h2>Join the <em>Edgward</em> network</h2>
          <p>Access new sources of qualified assignments with no commercial outlay. Our platform connects you directly with verified clients.</p>
          <a href={L('/entreprises-securite')} class="btn-primary">
            Become a partner
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="become-stats">
          <div class="become-stat">
            <strong>9+</strong>
            <span>active partners</span>
          </div>
          <div class="become-stat">
            <strong>240+</strong>
            <span>Edgward clients</span>
          </div>
          <div class="become-stat">
            <strong>&lt;20 min</strong>
            <span>average time</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--navy);
    color: white;
    padding: 80px 0 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -200px; left: 50%;
    transform: translateX(-50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 12px; color: var(--brand-light);
    font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.025em; margin-bottom: 20px; color: white;
  }
  .hero h1 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .hero p { font-size: 17px; color: #cbd5e1; line-height: 1.6; max-width: 540px; margin: 0 auto; }

  .partners-section { background: white; }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* CRITERIA */
  .criteria-section { background: var(--soft); }
  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .criterion {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
  }
  .criterion-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--brand);
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 28px;
    margin-bottom: 12px;
    line-height: 1;
  }
  .criterion h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .criterion p { font-size: 13px; color: var(--text-muted); line-height: 1.6; }

  /* BECOME */
  .become-section { background: white; }
  .become-block {
    background: var(--navy);
    border-radius: var(--radius-lg);
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    position: relative;
    overflow: hidden;
  }
  .become-block::before {
    content: '';
    position: absolute;
    top: -50%; right: -10%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .become-content { position: relative; z-index: 1; color: white; flex: 1; }
  .become-eyebrow {
    display: inline-block;
    font-size: 12px; color: var(--brand-light);
    font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; margin-bottom: 12px;
  }
  .become-content h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 800; line-height: 1.15;
    letter-spacing: -0.02em; margin-bottom: 14px;
    color: white;
  }
  .become-content h2 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--brand-light); }
  .become-content p { font-size: 15px; color: #cbd5e1; line-height: 1.6; margin-bottom: 24px; max-width: 480px; }
  .become-stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  .become-stat { text-align: right; }
  .become-stat strong { display: block; font-size: 28px; font-weight: 800; color: white; letter-spacing: -0.02em; }
  .become-stat span { font-size: 12px; color: #94a3b8; }

  @media (max-width: 1024px) {
    .criteria-grid { grid-template-columns: repeat(2, 1fr); }
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
    .become-block { flex-direction: column; }
    .become-stats { flex-direction: row; align-self: stretch; justify-content: space-around; }
    .become-stat { text-align: center; }
  }
  @media (max-width: 640px) {
    .partners-grid { grid-template-columns: 1fr; }
    .criteria-grid { grid-template-columns: 1fr; }
  }
</style>
