---
import Base from '../layouts/Base.astro';
import CarteEvenements from '../components/CarteEvenements.astro';
import data from '../data/evenements-securite.json';

const evenements = data.evenements ?? [];
const dateMaj = data.genereLe
  ? new Intl.DateTimeFormat('fr-CH', { timeZone: 'Europe/Zurich', day: '2-digit', month: 'long', hour: '2-digit', minute: '2-digit' }).format(new Date(data.genereLe))
  : '';

const title = 'Carte des événements de sécurité - Suisse romande | Edgward';
const description = "Carte des principaux événements de sécurité (cambriolages, agressions, incendies, accidents, cyber…) relayés en Suisse romande ces derniers jours. Actualisée automatiquement 2× par jour.";
---

<Base title={title} description={description}>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Veille sécurité</span>
        <h2>Carte des <em>événements</em> · Suisse romande</h2>
        <p class="section-subtitle">
          Les principaux événements de sécurité relayés dans les médias et les communiqués de police au cours des derniers jours.
          {dateMaj && ` Dernière mise à jour : ${dateMaj}.`}
        </p>
      </div>

      <div class="carte-lead">
        <p>Retrouvez toutes les alertes et informations de sécurité, ainsi que les liens directs vers les articles, directement sur Edgward.</p>
        <a href="/#telecharger" class="btn btn-primary">Télécharger maintenant</a>
      </div>

      <CarteEvenements evenements={evenements} genereLe={data.genereLe} />
    </div>
  </section>

  <section class="carte-cta">
    <div class="container">
      <div class="cc-inner">
        <div class="cc-text">
          <h2>Ces alertes, <em>directement sur votre téléphone</em></h2>
          <p>La carte se met à jour deux fois par jour. Avec l'application Edgward, recevez une notification <b>dès qu'un événement de sécurité survient près de chez vous</b>, et déclenchez une intervention à la demande en un geste.</p>
        </div>
        <div class="cc-actions">
          <a href="/alertes" class="btn btn-primary">Activer les alertes</a>
          <a href="/#telecharger" class="btn btn-secondary">Télécharger l'app</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .carte-lead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    max-width: 900px;
    margin: -28px auto 34px;
    padding: 16px 22px;
    background: var(--brand-soft);
    border: 1px solid rgba(70, 120, 220, 0.22);
    border-radius: 14px;
  }
  .carte-lead p {
    margin: 0;
    flex: 1 1 380px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--navy);
  }
  .carte-lead .btn { flex: none; white-space: nowrap; }
  @media (max-width: 640px) {
    .carte-lead { flex-direction: column; align-items: stretch; text-align: center; }
    .carte-lead .btn { justify-content: center; }
  }

  .carte-cta {
    background: var(--navy);
    color: #fff;
    padding: 72px 0;
    position: relative;
    overflow: hidden;
  }
  .carte-cta::before {
    content: '';
    position: absolute;
    top: 50%; left: 78%;
    transform: translate(-50%, -50%);
    width: 720px; height: 720px;
    background: radial-gradient(circle, var(--brand-glow) 0%, transparent 55%);
    pointer-events: none;
  }
  .cc-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    flex-wrap: wrap;
  }
  .cc-text { flex: 1 1 460px; }
  .cc-text h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 12px;
    text-wrap: balance;
  }
  .cc-text h2 em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--brand-light);
  }
  .cc-text p { font-size: 15px; color: #cbd5e1; line-height: 1.6; max-width: 620px; }
  .cc-text p b { color: #fff; font-weight: 600; }
  .cc-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 720px) {
    .cc-inner { flex-direction: column; align-items: flex-start; }
    .cc-actions { width: 100%; }
    .cc-actions .btn { flex: 1; justify-content: center; }
  }
</style>
